#
# Environment file for rocm-ernic systemd service.
# Sourced by systemd EnvironmentFile= and by
# rocm-ernic-launcher when run standalone.
#
# Install location: /etc/rocm-ernic/rocm-ernic.env

# ── Server binary and directories ──────────────────
ERNIC_BIN=/usr/local/bin/rocm-ernic
ERNIC_RUN_DIR=/run/rocm-ernic
ERNIC_LOG_DIR=/var/log/rocm-ernic

# ── Device mode ────────────────────────────────────
# ionic  : upstream ionic.ko + ionic_rdma.ko guest driver
#          (VID:DID 1022:8001).  The default.
# legacy : DEPRECATED PVRDMA-derived device (1022:8000)
#          driven by the out-of-tree rocm_ernic modules.
ERNIC_DEVICE_MODE=ionic

# In ionic mode each instance attaches to a host TAP named
# ${ERNIC_TAP_PREFIX}<instance>, enslaved to ERNIC_TAP_BRIDGE
# so guests can reach each other.  Instances whose TAP is
# missing start without Ethernet.  Create them with:
#   ip tuntap add dev ernic-tap1 mode tap user $USER
ERNIC_TAP_PREFIX=ernic-tap
ERNIC_TAP_BRIDGE=ernicbr0

# ── Instance configuration ─────────────────────────
# Total instance count. Instance 1 is the TCP manager;
# instances 2..N are workers.
ERNIC_INSTANCES=4

# TCP backend mesh settings (manager <-> workers).
ERNIC_TCP_PORT=6320
ERNIC_MANAGER_IP=127.0.0.1

# Server log verbosity: none | error | warn | info | debug.
# warn keeps the steady-state logs to WARN/ERROR plus a short
# startup banner; info restores the per-operation INFO lines.
ERNIC_LOG_LEVEL=warn

# Legacy shorthand for ERNIC_LOG_LEVEL=debug (true / false).
ERNIC_VERBOSE=false

# ── MAC addresses ──────────────────────────────────
# Per-instance MAC overrides.  Leave unset for
# deterministic MACs derived from /etc/machine-id.
#ERNIC_MAC_1=aa:bb:cc:dd:ee:01
#ERNIC_MAC_2=aa:bb:cc:dd:ee:02
#ERNIC_MAC_3=aa:bb:cc:dd:ee:03
#ERNIC_MAC_4=aa:bb:cc:dd:ee:04

# ── Driver distribution ───────────────────────────
# ionic mode ships the kernel patches plus the DKMS helper;
# the guest fetches the upstream ionic sources itself.
# Set to /usr/share/rocm-ernic/driver-legacy for legacy mode.
ERNIC_DRIVER_SOURCE=/usr/share/rocm-ernic/patches
ERNIC_DRIVER_TARBALL=/tmp/rocm-ernic-driver.tar.gz

# ── QEMU / VM defaults ────────────────────────────
ERNIC_QEMU_MINIMAL=$HOME/Projects/qemu-minimal
ERNIC_QEMU_PATH=/opt/qemu-v10.1.2/bin/
ERNIC_VM_IMAGE_DIR=$ERNIC_QEMU_MINIMAL/images
ERNIC_VM_NAME=stebates-test-vm
ERNIC_VM_VCPUS=4
ERNIC_VM_MEM=8192
ERNIC_VM_SSH_USER=ubuntu
ERNIC_VM_SSH_BASE_PORT=2222

# Golden backing qcow2.  When set and a per-instance
# overlay does not exist, ernicctl vm-launch creates
# one automatically via qemu-img.
#ERNIC_VM_BACKING=/opt/qemu-images/backing/example-backing.qcow2

# QEMU UDP multicast group for inter-VM L2 networking.
# When set, each VM gets a second virtio-net NIC on
# this shared segment (run-vm MCAST_GROUP feature).
#ERNIC_VM_MCAST_GROUP=230.0.0.1:1234

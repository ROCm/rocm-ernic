#
# rocm-ernic-driver-pack
#
# Builds a tarball containing everything a VM needs to
# compile and load the rocm-ernic guest driver: the kernel
# patches plus the fetch and DKMS helper scripts (the guest
# pulls the upstream ionic sources itself) and
# vm-driver-install.sh, a self-contained installer.
#
# The tarball is placed at $ERNIC_DRIVER_TARBALL
# (default /tmp/rocm-ernic-driver.tar.gz).
#
# Install: /usr/local/libexec/rocm-ernic/

set -euo pipefail

ENV_FILE="/etc/rocm-ernic/rocm-ernic.env"
if [ -f "${ENV_FILE}" ]; then
    set -a
    # shellcheck disable=SC1090
    . "${ENV_FILE}"
    set +a
fi

ERNIC_SHARE_DIR="${ERNIC_SHARE_DIR:-/usr/share/rocm-ernic}"
ERNIC_DRIVER_SOURCE="${ERNIC_DRIVER_SOURCE:-${ERNIC_SHARE_DIR}/patches}"
ERNIC_DRIVER_TARBALL="${ERNIC_DRIVER_TARBALL:-/tmp/rocm-ernic-driver.tar.gz}"

STAGING="/tmp/rocm-ernic-driver-staging"
DEST="${STAGING}/rocm-ernic-driver"

log_info() { echo "driver-pack: $*"; }
log_error() { echo "driver-pack: ERROR: $*" >&2; }

if [ ! -d "${ERNIC_DRIVER_SOURCE}" ]; then
    log_error "Driver source not found:" \
        "${ERNIC_DRIVER_SOURCE}"
    exit 1
fi

rm -rf "${STAGING}"
mkdir -p "${DEST}"

log_info "Collecting driver sources from" \
    "${ERNIC_DRIVER_SOURCE}..."

mkdir -p "${DEST}/patches"
cp "${ERNIC_DRIVER_SOURCE}"/*.patch "${DEST}/patches/"
for helper in fetch-ionic-sources.sh setup-ionic-dkms.sh; do
    if [ -f "${ERNIC_SHARE_DIR}/${helper}" ]; then
        cp "${ERNIC_SHARE_DIR}/${helper}" "${DEST}/"
        chmod +x "${DEST}/${helper}"
    else
        log_error "Missing ${ERNIC_SHARE_DIR}/${helper}"
        exit 1
    fi
done
# Ship the ref the host was configured with, so the guest fetches
# the same baseline the patches beside it were generated against.
if [ -f "${ERNIC_SHARE_DIR}/ionic-kernel-ref" ]; then
    cp "${ERNIC_SHARE_DIR}/ionic-kernel-ref" "${DEST}/"
else
    log_error "Missing ${ERNIC_SHARE_DIR}/ionic-kernel-ref"
    exit 1
fi

# Generate the in-VM installer script from the installed
# template.  ERNIC_SHARE_DIR first: hardcoding a prefix here
# packed whatever an older install had left at /usr/local
# rather than the tree this run was configured against.  The
# script's own directory is the fallback so the pack still
# works from a source checkout.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for template in "${ERNIC_SHARE_DIR}/vm-driver-install.sh.in" \
                "${SCRIPT_DIR}/vm-driver-install.sh.in"; do
    if [ -f "${template}" ]; then
        cp "${template}" "${DEST}/vm-driver-install.sh"
        chmod +x "${DEST}/vm-driver-install.sh"
        break
    fi
done
# Without it the tarball is inert, so do not ship one quietly.
if [ ! -f "${DEST}/vm-driver-install.sh" ]; then
    log_error "Missing vm-driver-install.sh.in in" \
        "${ERNIC_SHARE_DIR} or ${SCRIPT_DIR}"
    exit 1
fi

log_info "Creating tarball ${ERNIC_DRIVER_TARBALL}..."
tar czf "${ERNIC_DRIVER_TARBALL}" \
    -C "${STAGING}" rocm-ernic-driver

rm -rf "${STAGING}"

log_info "Driver tarball ready:" \
    "${ERNIC_DRIVER_TARBALL}"
ls -lh "${ERNIC_DRIVER_TARBALL}"

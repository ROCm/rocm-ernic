def cmd_vm_launch(args):
    m = read_manifest()
    inst = find_instance(m, args.instance)
    if not inst:
        print(f"ERROR: Instance {args.instance}"
              " not found.", file=sys.stderr)
        sys.exit(1)
    if not pid_alive(inst["pid"]):
        print(f"ERROR: Instance {args.instance}"
              " is not running.", file=sys.stderr)
        sys.exit(1)

    run_vm = os.path.join(
        CFG["ERNIC_QEMU_MINIMAL"], "qemu", "run-vm"
    )
    if not os.path.isfile(run_vm):
        print(f"ERROR: run-vm not found: {run_vm}",
              file=sys.stderr)
        sys.exit(1)

    ssh_port = args.ssh_port or (
        int(CFG["ERNIC_VM_SSH_BASE_PORT"])
        + args.instance - 1
    )
    vm_name = args.vm_name or CFG["ERNIC_VM_NAME"]
    vcpus = str(args.vcpus or CFG["ERNIC_VM_VCPUS"])
    mem = str(args.mem or CFG["ERNIC_VM_MEM"])

    image_dir = CFG["ERNIC_VM_IMAGE_DIR"]
    overlay = os.path.join(
        image_dir, f"{vm_name}.qcow2"
    )
    backing = CFG.get("ERNIC_VM_BACKING", "")
    if not os.path.isfile(overlay):
        if backing and os.path.isfile(backing):
            gen_vm = os.path.join(
                CFG["ERNIC_QEMU_MINIMAL"],
                "qemu", "gen-vm",
            )
            if os.path.isfile(gen_vm):
                print("Creating overlay via gen-vm:")
                print(f"  backing: {backing}")
                print(f"  overlay: {overlay}")
                gen_env = dict(os.environ)
                gen_env.update({
                    "VM_NAME": vm_name,
                    "IMAGES": image_dir,
                    "BACKING_FILE": backing,
                })
                subprocess.run(
                    [gen_vm], env=gen_env, check=True,
                )
            else:
                print("Creating overlay via qemu-img:")
                print(f"  backing: {backing}")
                print(f"  overlay: {overlay}")
                subprocess.run([
                    "qemu-img", "create",
                    "-F", "qcow2",
                    "-b", backing,
                    "-f", "qcow2",
                    overlay,
                ], check=True)
        elif backing:
            print(
                f"ERROR: Backing file not found:"
                f" {backing}",
                file=sys.stderr,
            )
            sys.exit(1)
        else:
            print(
                f"ERROR: VM image not found:"
                f" {overlay}",
                file=sys.stderr,
            )
            print(
                "Set ERNIC_VM_BACKING in the env file"
                " to auto-create overlays.",
                file=sys.stderr,
            )
            sys.exit(1)

    qmp_sock = os.path.join(
        RUN_DIR, f"qmp-{args.instance}.sock"
    )

    env = dict(os.environ)
    env.update({
        "QEMU_PATH": CFG["ERNIC_QEMU_PATH"],
        "VM_NAME": vm_name,
        "IMAGES": CFG["ERNIC_VM_IMAGE_DIR"],
        "SSH_PORT": str(ssh_port),
        "VCPUS": vcpus,
        "VMEM": mem,
        # "disable" falls back to TCG, which is far
        # slower but lets functional tests run where
        # /dev/kvm is unavailable (unprivileged CI,
        # nested virt without KVM exposed).
        "KVM": os.environ.get("KVM", "enable"),
        "VFIO_USERDEV": inst["socket"],
        "QMP_SOCKET": qmp_sock,
    })

    if backing:
        env["BACKING_SHARED"] = "true"

    mcast = CFG.get("ERNIC_VM_MCAST_GROUP", "")
    if mcast:
        env["MCAST_GROUP"] = mcast

    pci_hostdev = getattr(args, "pci_hostdev", None)
    if pci_hostdev:
        env["PCI_HOSTDEV"] = pci_hostdev

    pci_mmio_bridge = getattr(
        args, "pci_mmio_bridge", False
    )
    if pci_mmio_bridge:
        env["PCI_MMIO_BRIDGE"] = "true"

    extra_hostfwd = getattr(args, "extra_hostfwd", None)
    if extra_hostfwd:
        env["EXTRA_HOSTFWD"] = extra_hostfwd

    nvme = getattr(args, "nvme", 0)
    if nvme > 0:
        env["NVME"] = str(nvme)

    qemu_aio = getattr(args, "qemu_aio", None)
    if qemu_aio:
        env["QEMU_AIO"] = qemu_aio

    print(f"Launching VM for instance {args.instance}:")
    print(f"  VM name:     {vm_name}")
    print(f"  SSH port:    {ssh_port}")
    print(f"  vfio-user:   {inst['socket']}")
    print(f"  QMP socket:  {qmp_sock}")
    if mcast:
        print(f"  MCAST group: {mcast}")
    if pci_hostdev:
        print(f"  PCI hostdev: {pci_hostdev}")
    if pci_mmio_bridge:
        print("  MMIO bridge: enabled")
    if extra_hostfwd:
        print(f"  Extra fwd:   {extra_hostfwd}")
    if nvme > 0:
        print(f"  NVMe SSDs:   {nvme}")

    logfile = os.path.join(
        LOG_DIR, f"vm-{args.instance}.log"
    )
    with open(logfile, "w") as lf:
        proc = subprocess.Popen(
            [run_vm],
            env=env,
            stdout=lf,
            stderr=subprocess.STDOUT,
        )

    device_id = f"ernic{args.instance}"
    root_port = "pcie-vfu.1"

    inst["vm"] = {
        "qmp_socket": qmp_sock,
        "device_id": device_id,
        "root_port": root_port,
        "ssh_port": ssh_port,
        "ssh_user": (
            args.ssh_user or CFG["ERNIC_VM_SSH_USER"]
        ),
        "attached": True,
        "vm_pid": proc.pid,
        "vm_name": vm_name,
        "launched_at": time.time(),
        "gpu": pci_hostdev or "",
    }
    write_manifest(m)
    print(f"VM started (PID {proc.pid}).")
    print(f"Log: {logfile}")
    print(f"SSH: ssh -p {ssh_port}"
          f" {_ssh_vm_target(inst['vm']['ssh_user'])}")


def cmd_vm_stop(args):
    m = read_manifest()
    inst = find_instance(m, args.instance)
    if not inst:
        print(f"ERROR: Instance {args.instance}"
              " not found.", file=sys.stderr)
        sys.exit(1)

    vm = inst.get("vm")
    if not vm:
        print(f"Instance {args.instance}"
              " has no VM attached.")
        return

    vm_pid = vm.get("vm_pid")
    qmp_sock = vm.get("qmp_socket")

    if qmp_sock and os.path.exists(qmp_sock):
        print("Sending QEMU quit via QMP...")
        qmp_quit(qmp_sock)
        time.sleep(3)

    if vm_pid and pid_alive(vm_pid):
        print(f"Killing VM process {vm_pid}...")
        os.kill(vm_pid, signal.SIGTERM)
        time.sleep(2)
        if pid_alive(vm_pid):
            os.kill(vm_pid, signal.SIGKILL)

    inst["vm"] = None
    write_manifest(m)
    print(f"VM for instance {args.instance} stopped.")


def cmd_vm_list(_args):
    m = read_manifest()
    has_vms = False
    fmt = "{:<4} {:<12} {:<7} {:<10} {:<30} {}"
    print(fmt.format(
        "ID", "VM_NAME", "VM_PID",
        "SSH_PORT", "QMP_SOCKET", "STATE",
    ))
    for inst in m["instances"]:
        vm = inst.get("vm")
        if not vm:
            continue
        has_vms = True
        vm_pid = vm.get("vm_pid", 0)
        alive = pid_alive(vm_pid) if vm_pid else False
        state = "running" if alive else "stopped"
        print(fmt.format(
            inst["id"],
            vm.get("vm_name", "-"),
            vm_pid if alive else 0,
            vm.get("ssh_port", "-"),
            vm.get("qmp_socket", "-"),
            state,
        ))
    if not has_vms:
        print("No VMs attached to any instance.")


# ── Argument parser ──────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="ernicctl",
        description=(
            "Admin CLI for the rocm-ernic"
            " systemd service."
        ),
    )
    sub = p.add_subparsers(dest="command")

    # -- service lifecycle --
    sp = sub.add_parser(
        "status", help="Show instance status",
    )
    sp.add_argument(
        "--json", action="store_true",
        help="Output as JSON",
    )
    sp.add_argument(
        "--rate", type=int, default=None,
        metavar="SECS",
        help="Show byte deltas over SECS seconds",
    )
    sp.add_argument(
        "--debug-vm-load",
        action="store_true",
        help="Print VM_LOAD diagnostics (QMP/SSH) to stderr",
    )

    sub.add_parser("start", help="Start the service")
    sub.add_parser("stop", help="Stop the service")
    sub.add_parser(
        "restart", help="Restart the service",
    )
    sub.add_parser(
        "reload", help="Reload service configuration",
    )

    sp = sub.add_parser(
        "logs", help="Tail instance logs",
    )
    sp.add_argument(
        "instance", nargs="?", type=int, default=None,
        help="Instance ID (omit for all)",
    )

    sp = sub.add_parser(
        "stats", help="Show instance stats",
    )
    sp.add_argument(
        "instance", nargs="?", type=int, default=None,
        help="Instance ID (omit for all)",
    )
    sp.add_argument(
        "--summary", action="store_true",
        help="Concise one-row-per-instance table",
    )

    # -- dynamic mesh --
    sub.add_parser(
        "add-instance",
        help="Add a new worker to the mesh",
    )

    sp = sub.add_parser(
        "remove-instance",
        help="Remove an instance from the mesh",
    )
    sp.add_argument(
        "instance", type=int, help="Instance ID",
    )

    sp = sub.add_parser(
        "attach",
        help="Hot-plug instance into a running VM",
    )
    sp.add_argument(
        "instance", type=int, help="Instance ID",
    )
    sp.add_argument(
        "--qmp", required=True,
        help="QMP socket path",
    )
    sp.add_argument("--device-id", default=None)
    sp.add_argument("--root-port", default=None)
    sp.add_argument(
        "--ssh-port", type=int, default=None,
    )
    sp.add_argument("--ssh-user", default=None)

    sp = sub.add_parser(
        "detach",
        help="Hot-unplug instance from its VM",
    )
    sp.add_argument(
        "instance", type=int, help="Instance ID",
    )
    sp.add_argument(
        "--unload-driver", action="store_true",
        help="rmmod guest driver before detaching",
    )

    sp = sub.add_parser(
        "hot-reload",
        help="Full hot-reload cycle for an instance",
    )
    sp.add_argument(
        "instance", type=int, help="Instance ID",
    )
    sp.add_argument(
        "--no-build", action="store_true",
        help="Skip the rebuild step",
    )
    sp.add_argument(
        "--update-driver", action="store_true",
        help="Push and reload guest driver",
    )

    # -- driver distribution --
    sub.add_parser(
        "driver-pack",
        help="Build the driver tarball",
    )

    sp = sub.add_parser(
        "driver-push",
        help="Push driver tarball to a VM",
    )
    sp.add_argument(
        "target", help="SSH target (user@host)",
    )
    sp.add_argument(
        "--port", type=int, default=22,
        help="SSH port (default 22)",
    )
    sp.add_argument(
        "--install", action="store_true",
        help="Run installer after copying",
    )

    # -- VM management --
    sp = sub.add_parser(
        "vm-launch",
        help="Launch a VM for an instance",
    )
    sp.add_argument(
        "instance", type=int, help="Instance ID",
    )
    sp.add_argument("--vm-name", default=None)
    sp.add_argument(
        "--ssh-port", type=int, default=None,
    )
    sp.add_argument(
        "--ssh-user", default=None,
    )
    sp.add_argument(
        "--vcpus", type=int, default=None,
    )
    sp.add_argument(
        "--mem", type=int, default=None,
        help="VM memory in MB",
    )
    sp.add_argument(
        "--pci-hostdev", default=None,
        help="PCI BDF address(es) for vfio-pci"
             " passthrough (comma-separated)",
    )
    sp.add_argument(
        "--pci-mmio-bridge",
        action="store_true", default=False,
        help="Enable pci-mmio-bridge device",
    )
    sp.add_argument(
        "--extra-hostfwd", default=None,
        help="Extra QEMU hostfwd rules appended to"
             " the user netdev (e.g."
             " ,hostfwd=tcp::9150-:9100)",
    )
    sp.add_argument(
        "--nvme", type=int, default=0,
        help="Number of emulated NVMe SSDs (0=none)",
    )
    sp.add_argument(
        "--qemu-aio", default=None,
        help="Override QEMU AIO backend (native/threads/io_uring)",
    )

    sp = sub.add_parser(
        "vm-stop", help="Stop a VM",
    )
    sp.add_argument(
        "instance", type=int, help="Instance ID",
    )

    sub.add_parser(
        "vm-list", help="List running VMs",
    )

    return p


DISPATCH = {
    "status": cmd_status,
    "start": cmd_start,
    "stop": cmd_stop,
    "restart": cmd_restart,
    "reload": cmd_reload,
    "logs": cmd_logs,
    "stats": cmd_stats,
    "add-instance": cmd_add_instance,
    "remove-instance": cmd_remove_instance,
    "attach": cmd_attach,
    "detach": cmd_detach,
    "hot-reload": cmd_hot_reload,
    "driver-pack": cmd_driver_pack,
    "driver-push": cmd_driver_push,
    "vm-launch": cmd_vm_launch,
    "vm-stop": cmd_vm_stop,
    "vm-list": cmd_vm_list,
}


def suggest_command(invalid):
    """Suggest the closest valid command."""
    from difflib import get_close_matches
    matches = get_close_matches(
        invalid, DISPATCH.keys(), n=1, cutoff=0.5
    )
    if matches:
        return matches[0]
    return None


def main():
    parser = build_parser()
    if len(sys.argv) > 1 \
            and sys.argv[1] not in DISPATCH \
            and not sys.argv[1].startswith("-"):
        suggestion = suggest_command(sys.argv[1])
        msg = (
            f"Unknown command: '{sys.argv[1]}'."
        )
        if suggestion:
            msg += f" Did you mean '{suggestion}'?"
        print(f"ERROR: {msg}", file=sys.stderr)
        sys.exit(1)
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)
    handler = DISPATCH.get(args.command)
    if handler:
        handler(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()

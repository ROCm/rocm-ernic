amdgpu: create plane and CRTC state with atomic_create_state on v7.4

v7.4-rc1 5589ef09f93b ("drm/plane: Remove reset") and its CRTC twin
removed the reset callbacks and drm_atomic_helper_{plane,crtc}_reset() in
favour of atomic_create_state, which returns the new state instead of
installing it.  Port the four upstream conversions:

  be34074931aa drm/amdgpu: vkms: Switch to drm_atomic_helper_crtc_create_state
  b5939c6999f9 drm/amdgpu: Convert to atomic_create_state
  32fbec62a3e9 drm/amdgpu: dm: Convert to atomic_create_state
  2bcec01cf105 drm/amdgpu_dm: Convert to atomic_create_state

The plane function here allocates three more objects than upstream's, so
it is the package's own body with upstream's shape.  The CRTC error path
cannot call amdgpu_dm_ism_fini(), which this release does not have.  The
KUnit tests under tests/ still name the reset functions and are not
converted; they are not built unless the kernel has CONFIG_KUNIT.

--- a/amd/amdgpu/amdgpu_vkms.c
+++ b/amd/amdgpu/amdgpu_vkms.c
@@ -121,7 +121,11 @@
 	.set_config             = drm_atomic_helper_set_config,
 	.destroy                = drm_crtc_cleanup,
 	.page_flip              = drm_atomic_helper_page_flip,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 4, 0)
+	.atomic_create_state    = drm_atomic_helper_crtc_create_state,
+#else
 	.reset                  = drm_atomic_helper_crtc_reset,
+#endif
 	.atomic_duplicate_state = drm_atomic_helper_crtc_duplicate_state,
 	.atomic_destroy_state   = drm_atomic_helper_crtc_destroy_state,
 #ifndef DRM_CRTC_VBLANK_TIMER_FUNCS
@@ -287,7 +291,11 @@
 	.update_plane		= drm_atomic_helper_update_plane,
 	.disable_plane		= drm_atomic_helper_disable_plane,
 	.destroy		= drm_plane_cleanup,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 4, 0)
+	.atomic_create_state	= drm_atomic_helper_plane_create_state,
+#else
 	.reset			= drm_atomic_helper_plane_reset,
+#endif
 	.atomic_duplicate_state = drm_atomic_helper_plane_duplicate_state,
 	.atomic_destroy_state	= drm_atomic_helper_plane_destroy_state,
 };
--- a/amd/display/amdgpu_dm/amdgpu_dm_crtc.c
+++ b/amd/display/amdgpu_dm/amdgpu_dm_crtc.c
@@ -493,6 +493,21 @@

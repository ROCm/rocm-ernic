+static struct ionic_lif *ionic_fi_lif;
+static int ionic_fi_qstart_fail;	/* fail the next N ionic_queue_start() */
+module_param_named(fi_qstart_fail, ionic_fi_qstart_fail, int, 0644);
+static int ionic_fi_qop_fw_reset;	/* next N ionic_queue_stop(): FW reset begins */
+module_param_named(fi_qop_fw_reset, ionic_fi_qop_fw_reset, int, 0644);
+static int ionic_fi_link_down;		/* link check sees the link down */
+module_param_named(fi_link_down, ionic_fi_link_down, int, 0644);
+
+/* What the heartbeat check does when it finds the firmware gone.  The up is
+ * left to the watchdog, which finds the firmware running; "hold" keeps it
+ * from looking until fwup.
+ */
+static void ionic_fi_fw_down(struct ionic_lif *lif, bool hold)
+{
+	struct ionic_dev *idev = &lif->ionic->idev;
+	struct ionic_deferred_work *work;
+
+	if (test_bit(IONIC_LIF_F_FW_RESET, lif->state) ||
+	    test_and_set_bit(IONIC_LIF_F_FW_STOPPING, lif->state))
+		return;
+	if (!hold)
+		idev->fw_status_ready = false;
+	work = kzalloc_obj(*work, GFP_KERNEL);
+	if (!work)
+		return;
+	work->type = IONIC_DW_TYPE_LIF_RESET;
+	work->fw_status = false;
+	ionic_lif_deferred_enqueue(lif, work);
+}
+
+static int ionic_fi_cmd_set(const char *val, const struct kernel_param *kp)
+{
+	struct ionic_lif *lif = ionic_fi_lif;
+
+	if (!lif)
+		return -ENODEV;
+	if (sysfs_streq(val, "fwdown"))
+		ionic_fi_fw_down(lif, false);
+	else if (sysfs_streq(val, "fwdown-hold"))
+		ionic_fi_fw_down(lif, true);
+	else if (sysfs_streq(val, "fwup"))
+		lif->ionic->idev.fw_status_ready = false;
+	else if (sysfs_streq(val, "txtimeout"))
+		schedule_work(&lif->tx_timeout_work);
+	else if (sysfs_streq(val, "linkcheck"))
+		ionic_link_status_check_request(lif, CAN_NOT_SLEEP);
+	else
+		return -EINVAL;
+	pr_info("ionic fi: %s\n", val);
+	return 0;
+}
+
+static const struct kernel_param_ops ionic_fi_cmd_ops = {
+	.set = ionic_fi_cmd_set,
+};
+module_param_cb(fi_cmd, &ionic_fi_cmd_ops, NULL, 0200);

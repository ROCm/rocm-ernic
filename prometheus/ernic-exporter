# ernic-exporter -- Prometheus metrics exporter for
# the rocm-ernic systemd service.
#
# Reads the same data sources as ernicctl: the
# instances.json manifest and per-instance *.stats
# text files under ERNIC_RUN_DIR.  Exposes metrics on
# an HTTP endpoint for Prometheus scraping.
#
# Dependencies: prometheus_client (pip)
# Install: /usr/local/bin/ernic-exporter

import glob
import json
import os
import pathlib
import signal
import sys
import time

from prometheus_client import (
    CollectorRegistry,
    generate_latest,
    CONTENT_TYPE_LATEST,
)
from prometheus_client.core import (
    CounterMetricFamily,
    GaugeMetricFamily,
)
from http.server import HTTPServer, BaseHTTPRequestHandler

# ── Configuration ─────────────────────────────────

ENV_FILE = "/etc/rocm-ernic/rocm-ernic.env"

DEFAULTS = {
    "ERNIC_RUN_DIR": "/run/rocm-ernic",
    "ERNIC_EXPORTER_PORT": "9840",
}


def load_env():
    cfg = dict(DEFAULTS)
    if os.path.isfile(ENV_FILE):
        with open(ENV_FILE) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    continue
                key, _, val = line.partition("=")
                cfg[key.strip()] = val.strip()
    for key in cfg:
        if key in os.environ:
            cfg[key] = os.environ[key]
    return cfg


CFG = load_env()
RUN_DIR = CFG["ERNIC_RUN_DIR"]
EXPORTER_PORT = int(CFG["ERNIC_EXPORTER_PORT"])
MANIFEST = os.path.join(RUN_DIR, "instances.json")


# ── Data readers (mirrored from ernicctl) ─────────

def read_manifest():
    if not os.path.isfile(MANIFEST):
        return {"instances": []}
    try:
        with open(MANIFEST) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {"instances": []}


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def get_uptime(pid):
    try:
        with open("/proc/uptime") as f:
            sys_up = float(f.read().split()[0])
        with open(f"/proc/{pid}/stat") as f:
            fields = f.read().rsplit(") ", 1)[1]
            start_ticks = int(fields.split()[19])
        hz = os.sysconf("SC_CLK_TCK")
        age = sys_up - (start_ticks / hz)
        return max(0, age)
    except (OSError, ValueError, IndexError):
        return None


def parse_stats_file(path):
    """Parse a .stats text file into {key: value}.

    Integer values are returned as int; string values
    (like connection state) are returned as str.
    """
    result = {}
    if not os.path.isfile(path):
        return result
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if " : " not in line:
                    continue
                key, _, val = line.partition(" : ")
                key = key.strip()
                val = val.strip()
                try:
                    result[key] = int(val)
                except ValueError:
                    result[key] = val
    except OSError:
        pass
    return result


def parse_stats_file_with_qps(path):
    """Parse a .stats file returning device stats and
    per-QP stats.

    Returns (device_stats_dict, {qp_handle: qp_dict}).
    The device dict uses the same flat key:value format
    as parse_stats_file.  The QP dict captures per-QP
    counters from the indented sections.
    """
    device = {}
    qps = {}
    if not os.path.isfile(path):
        return device, qps
    try:
        with open(path) as fh:
            current_qp = None
            in_opcode_section = False
            for line in fh:
                stripped = line.strip()
                if not stripped:
                    in_opcode_section = False
                    continue

                if stripped.startswith("QP ") \
                        and stripped.endswith(":"):
                    try:
                        qp_handle = stripped[3:-1].strip()
                        current_qp = qp_handle
                        qps[current_qp] = {}
                        in_opcode_section = False
                    except (ValueError, IndexError):
                        current_qp = None
                    continue

                if stripped == "WQEs by opcode:":
                    in_opcode_section = True
                    continue

                if " : " not in stripped:
                    # Any other bare "Section:" header ends the
                    # current QP.  Without this, a device-level
                    # key emitted after the per-QP block would be
                    # silently attributed to the last QP seen.
                    if stripped.endswith(":"):
                        current_qp = None
                        in_opcode_section = False
                    continue

                key, _, val = stripped.partition(" : ")
                key = key.strip()
                val = val.strip()
                try:
                    int_val = int(val)
                except ValueError:
                    int_val = None

                if current_qp is not None:
                    if in_opcode_section:
                        if int_val is not None:
                            qps[current_qp][
                                f"opcode_{key}"
                            ] = int_val
                    else:
                        qps[current_qp][key] = (
                            int_val if int_val is not None
                            else val
                        )
                else:
                    device[key] = (
                        int_val if int_val is not None
                        else val
                    )
    except OSError:
        pass
    return device, qps


def read_all_stats_with_qps():
    """Read stats + QP data for every *.stats file.

    Returns {instance_id_int: (device_dict, qps_dict)}.
    """
    result = {}
    for sf in glob.glob(
        os.path.join(RUN_DIR, "*.stats")
    ):
        name = pathlib.Path(sf).stem
        try:
            inst_id = int(name)
        except ValueError:
            continue
        result[inst_id] = parse_stats_file_with_qps(sf)
    return result


# ── Prometheus metrics ────────────────────────────
#
# This is a custom collector rather than a set of
# module-level metric objects for two reasons.  Every
# series is rebuilt from scratch on each scrape, so a
# departed instance or a destroyed QP simply stops being
# yielded -- previously that needed pokes at the private
# ._metrics dict.  And the cumulative series can carry
# TYPE counter while still being set from the absolute
# values the server writes: prometheus_client's Counter
# only exposes inc(), so an exporter that reads totals
# from a file cannot use it.

INSTANCE_LABELS = ["ernic_id", "role"]
QP_LABELS = ["ernic_id", "role", "qp"]

# Per-instance counters that map 1:1 onto a key in the
# .stats file: (metric name, stats key, help).
INSTANCE_COUNTERS = [
    ("ernic_ip_bytes_tx_total", "total_ip_bytes_tx",
     "Total IP/Ethernet bytes transmitted"),
    ("ernic_ip_bytes_rx_total", "total_ip_bytes_rx",
     "Total IP/Ethernet bytes received"),
    ("ernic_rdma_bytes_sent_total", "total_bytes_sent",
     "Total bytes sent via RDMA SEND operations"),
    ("ernic_rdma_bytes_received_total",
     "total_bytes_received",
     "Total bytes received via RDMA RECV operations"),
    ("ernic_rdma_bytes_read_total",
     "total_bytes_rdma_read",
     "Total bytes transferred via RDMA Read"),
    ("ernic_rdma_bytes_write_total",
     "total_bytes_rdma_write",
     "Total bytes transferred via RDMA Write"),
    ("ernic_flr_reset_total", "reset_count",
     "Total FLR/device reset count"),
    ("ernic_commands_total", "commands",
     "Total admin queue commands processed"),
    ("ernic_interrupts_total", "interrupts",
     "Total interrupts delivered"),
    ("ernic_mmio_reads_total", "mmio_reads_total",
     "Total MMIO read operations"),
    ("ernic_mmio_writes_total", "mmio_writes_total",
     "Total MMIO write operations"),
    ("ernic_stats_writes_total", "Write count",
     "Number of times the server has written stats"),
]

# Aggregates, summed from INSTANCE_COUNTERS members
# rather than read directly: (metric, [stats keys], help).
INSTANCE_AGGREGATES = [
    ("ernic_rdma_bytes_total",
     ["total_bytes_sent", "total_bytes_received",
      "total_bytes_rdma_read", "total_bytes_rdma_write"],
     "Total RDMA bytes (send+recv+read+write)"),
    ("ernic_ip_bytes_total",
     ["total_ip_bytes_tx", "total_ip_bytes_rx"],
     "Total IP bytes (tx+rx)"),
]

# Per-QP counters: (metric name, QP stats key, help).
QP_COUNTERS = [
    ("ernic_qp_bytes_sent_total", "bytes_sent",
     "Bytes sent via SEND on this QP"),
    ("ernic_qp_bytes_received_total", "bytes_received",
     "Bytes received via RECV on this QP"),
    ("ernic_qp_bytes_rdma_read_total", "bytes_rdma_read",
     "Bytes transferred via RDMA Read on this QP"),
    ("ernic_qp_bytes_rdma_write_total",
     "bytes_rdma_write",
     "Bytes transferred via RDMA Write on this QP"),
    ("ernic_qp_wqes_processed_total", "wqes_processed",
     "Total WQEs processed on this QP"),
    ("ernic_qp_cqes_posted_total", "cqes_posted",
     "Total CQEs posted on this QP"),
    ("ernic_qp_doorbell_send_total", "doorbell_send",
     "Send doorbell rings on this QP"),
    ("ernic_qp_doorbell_recv_total", "doorbell_recv",
     "Receive doorbell rings on this QP"),
]


def stat_int(stats, key):
    """Fetch a counter from a parsed stats dict.

    A malformed line parses as a string rather than an
    int; treat anything non-integer, and anything
    missing, as zero.
    """
    val = stats.get(key, 0)
    return val if isinstance(val, int) else 0


class ErnicCollector:
    """Reads every data source once per scrape and
    yields the full metric set."""

    def collect(self):
        manifest = read_manifest()
        instances = manifest.get("instances", [])
        all_stats = read_all_stats_with_qps()

        # Cluster-level gauges.
        m_instances = GaugeMetricFamily(
            "ernic_instances",
            "Number of rocm-ernic server instances",
        )
        m_vms = GaugeMetricFamily(
            "ernic_vms",
            "Number of attached VMs",
        )

        # Per-instance gauges.
        m_up = GaugeMetricFamily(
            "ernic_instance_up",
            "Whether instance process is alive"
            " (1=running, 0=dead)",
            labels=["ernic_id", "role", "mac"],
        )
        m_uptime = GaugeMetricFamily(
            "ernic_instance_uptime_seconds",
            "Instance process uptime in seconds",
            labels=INSTANCE_LABELS,
        )
        m_vm_attached = GaugeMetricFamily(
            "ernic_vm_attached",
            "Whether a VM is attached to this instance"
            " (1=yes, 0=no)",
            labels=["ernic_id", "role", "vm_name"],
        )
        m_vm_uptime = GaugeMetricFamily(
            "ernic_vm_uptime_seconds",
            "VM uptime in seconds",
            labels=INSTANCE_LABELS,
        )
        m_vm_gpu = GaugeMetricFamily(
            "ernic_vm_gpu_passthrough",
            "Whether GPU passthrough is enabled"
            " (1=yes, 0=no)",
            labels=INSTANCE_LABELS,
        )
        m_conn = GaugeMetricFamily(
            "ernic_connection_up",
            "Connection state (1=connected, 0=other)",
            labels=["ernic_id", "role", "state"],
        )
        m_qp_count = GaugeMetricFamily(
            "ernic_qp_count",
            "Number of active Queue Pairs",
            labels=INSTANCE_LABELS,
        )

        counters = {
            name: CounterMetricFamily(
                name, doc, labels=INSTANCE_LABELS,
            )
            for name, _, doc in
            INSTANCE_COUNTERS + INSTANCE_AGGREGATES
        }
        counters.update({
            name: CounterMetricFamily(
                name, doc, labels=QP_LABELS,
            )
            for name, _, doc in QP_COUNTERS
        })

        m_instances.add_metric([], len(instances))
        vm_count = 0

        for inst in instances:
            iid = str(inst["id"])
            role = inst.get("role", "unknown")
            mac = inst.get("mac", "")
            alive = pid_alive(inst["pid"])
            inst_labels = [iid, role]

            m_up.add_metric(
                [iid, role, mac], 1 if alive else 0,
            )

            up = get_uptime(inst["pid"]) if alive else None
            if up is not None:
                m_uptime.add_metric(inst_labels, up)

            # VM lifecycle
            vm = inst.get("vm")
            has_vm = (
                vm is not None
                and isinstance(vm, dict)
                and vm.get("attached", False)
            )
            vm_name = vm.get("vm_name", "") if has_vm else ""
            m_vm_attached.add_metric(
                [iid, role, vm_name], 1 if has_vm else 0,
            )

            if has_vm:
                vm_count += 1
                launched = vm.get("launched_at")
                if launched:
                    vm_up = time.time() - launched
                else:
                    vm_pid = vm.get("vm_pid")
                    vm_up = (
                        get_uptime(vm_pid)
                        if vm_pid else None
                    )
                if vm_up is not None:
                    m_vm_uptime.add_metric(
                        inst_labels, vm_up,
                    )
                gpu = vm.get("gpu", "")
                m_vm_gpu.add_metric(
                    inst_labels, 1 if gpu else 0,
                )

            # Device stats
            stats_pair = all_stats.get(inst["id"])
            if stats_pair is None:
                continue
            stats, qps = stats_pair

            for name, key, _ in INSTANCE_COUNTERS:
                counters[name].add_metric(
                    inst_labels, stat_int(stats, key),
                )
            for name, keys, _ in INSTANCE_AGGREGATES:
                counters[name].add_metric(
                    inst_labels,
                    sum(stat_int(stats, k) for k in keys),
                )

            conn = stats.get("connection", "unknown")
            if not isinstance(conn, str):
                conn = str(conn)
            m_conn.add_metric(
                [iid, role, conn],
                1 if conn.startswith("connected") else 0,
            )

            # Per-QP metrics
            m_qp_count.add_metric(inst_labels, len(qps))
            for qp_handle, qp_stats in qps.items():
                qp_labels = [iid, role, str(qp_handle)]
                for name, key, _ in QP_COUNTERS:
                    counters[name].add_metric(
                        qp_labels,
                        stat_int(qp_stats, key),
                    )

        m_vms.add_metric([], vm_count)

        yield m_instances
        yield m_vms
        yield m_up
        yield m_uptime
        yield m_vm_attached
        yield m_vm_uptime
        yield m_vm_gpu
        yield m_conn
        yield m_qp_count
        for name, _, _ in (
            INSTANCE_COUNTERS + INSTANCE_AGGREGATES
            + QP_COUNTERS
        ):
            yield counters[name]


registry = CollectorRegistry()
registry.register(ErnicCollector())


# ── HTTP handler ──────────────────────────────────

class MetricsHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/metrics":
            # generate_latest drives ErnicCollector.collect(),
            # which re-reads every data source.
            output = generate_latest(registry)
            self.send_response(200)
            self.send_header(
                "Content-Type", CONTENT_TYPE_LATEST,
            )
            self.end_headers()
            self.wfile.write(output)
        elif self.path == "/":
            body = (
                b"<html><body>"
                b"<h1>ernic-exporter</h1>"
                b"<p><a href='/metrics'>Metrics</a></p>"
                b"</body></html>"
            )
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_error(404)

    def log_message(self, format, *args):
        sys.stderr.write(
            f"[ernic-exporter] {args[0]} "
            f"{args[1]} {args[2]}\n"
        )


# ── Main ──────────────────────────────────────────

def main():
    port = EXPORTER_PORT
    if len(sys.argv) > 1:
        try:
            port = int(sys.argv[1])
        except ValueError:
            print(
                f"Usage: {sys.argv[0]} [PORT]",
                file=sys.stderr,
            )
            sys.exit(1)

    server = HTTPServer(("", port), MetricsHandler)

    def shutdown_handler(signum, frame):
        print(
            "\n[ernic-exporter] Shutting down...",
            file=sys.stderr,
        )
        server.shutdown()

    signal.signal(signal.SIGTERM, shutdown_handler)
    signal.signal(signal.SIGINT, shutdown_handler)

    print(
        f"[ernic-exporter] Listening on"
        f" :{port}/metrics",
        file=sys.stderr,
    )
    print(
        f"[ernic-exporter] Reading stats from"
        f" {RUN_DIR}",
        file=sys.stderr,
    )

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()

# ── Metric collection ────────────────────────────

def collect_metrics():
    """Read all data sources and update Prometheus
    gauge values."""
    manifest = read_manifest()
    instances = manifest.get("instances", [])
    all_stats = read_all_stats_with_qps()

    ernic_instances_total.set(len(instances))

    # Clear child metrics so stale instances disappear
    ernic_instance_up._metrics.clear()
    ernic_instance_uptime_seconds._metrics.clear()
    ernic_vm_attached._metrics.clear()
    ernic_vm_uptime_seconds._metrics.clear()
    ernic_vm_gpu_passthrough._metrics.clear()
    ernic_ip_bytes_tx_total._metrics.clear()
    ernic_ip_bytes_rx_total._metrics.clear()
    ernic_rdma_bytes_sent_total._metrics.clear()
    ernic_rdma_bytes_received_total._metrics.clear()
    ernic_rdma_bytes_read_total._metrics.clear()
    ernic_rdma_bytes_write_total._metrics.clear()
    ernic_rdma_bytes_total._metrics.clear()
    ernic_ip_bytes_total._metrics.clear()
    ernic_flr_reset_total._metrics.clear()
    ernic_commands_total._metrics.clear()
    ernic_interrupts_total._metrics.clear()
    ernic_connection_up._metrics.clear()
    ernic_mmio_reads_total._metrics.clear()
    ernic_mmio_writes_total._metrics.clear()
    ernic_qp_count._metrics.clear()
    ernic_qp_bytes_sent_total._metrics.clear()
    ernic_qp_bytes_received_total._metrics.clear()
    ernic_qp_bytes_rdma_read_total._metrics.clear()
    ernic_qp_bytes_rdma_write_total._metrics.clear()
    ernic_qp_wqes_processed_total._metrics.clear()
    ernic_qp_cqes_posted_total._metrics.clear()
    ernic_qp_doorbell_send_total._metrics.clear()
    ernic_qp_doorbell_recv_total._metrics.clear()
    ernic_stats_writes_total._metrics.clear()

    vm_count = 0

    for inst in instances:
        iid = str(inst["id"])
        role = inst.get("role", "unknown")
        mac = inst.get("mac", "")
        alive = pid_alive(inst["pid"])

        ernic_instance_up.labels(
            instance=iid, role=role, mac=mac,
        ).set(1 if alive else 0)

        up = get_uptime(inst["pid"]) if alive else None
        if up is not None:
            ernic_instance_uptime_seconds.labels(
                instance=iid,
            ).set(up)

        # VM lifecycle
        vm = inst.get("vm")
        has_vm = (
            vm is not None
            and isinstance(vm, dict)
            and vm.get("attached", False)
        )
        ernic_vm_attached.labels(
            instance=iid,
        ).set(1 if has_vm else 0)

        if has_vm:
            vm_count += 1
            launched = vm.get("launched_at")
            if launched:
                vm_up = time.time() - launched
            else:
                vm_pid = vm.get("vm_pid")
                vm_up = (
                    get_uptime(vm_pid)
                    if vm_pid else None
                )
            if vm_up is not None:
                ernic_vm_uptime_seconds.labels(
                    instance=iid,
                ).set(vm_up)
            gpu = vm.get("gpu", "")
            ernic_vm_gpu_passthrough.labels(
                instance=iid,
            ).set(1 if gpu else 0)

        # Device stats
        stats_pair = all_stats.get(inst["id"])
        if stats_pair is None:
            continue
        stats, qps = stats_pair

        ip_tx = stats.get("total_ip_bytes_tx", 0)
        ip_rx = stats.get("total_ip_bytes_rx", 0)
        rdma_sent = stats.get("total_bytes_sent", 0)
        rdma_recv = stats.get("total_bytes_received", 0)
        rdma_read = stats.get("total_bytes_rdma_read", 0)
        rdma_write = stats.get(
            "total_bytes_rdma_write", 0,
        )

        if not isinstance(ip_tx, int):
            ip_tx = 0
        if not isinstance(ip_rx, int):
            ip_rx = 0
        if not isinstance(rdma_sent, int):
            rdma_sent = 0
        if not isinstance(rdma_recv, int):
            rdma_recv = 0
        if not isinstance(rdma_read, int):
            rdma_read = 0
        if not isinstance(rdma_write, int):
            rdma_write = 0

        ernic_ip_bytes_tx_total.labels(
            instance=iid,
        ).set(ip_tx)
        ernic_ip_bytes_rx_total.labels(
            instance=iid,
        ).set(ip_rx)
        ernic_rdma_bytes_sent_total.labels(
            instance=iid,
        ).set(rdma_sent)
        ernic_rdma_bytes_received_total.labels(
            instance=iid,
        ).set(rdma_recv)
        ernic_rdma_bytes_read_total.labels(
            instance=iid,
        ).set(rdma_read)
        ernic_rdma_bytes_write_total.labels(
            instance=iid,
        ).set(rdma_write)

        ernic_rdma_bytes_total.labels(
            instance=iid,
        ).set(rdma_sent + rdma_recv + rdma_read
              + rdma_write)
        ernic_ip_bytes_total.labels(
            instance=iid,
        ).set(ip_tx + ip_rx)

        # FLR / events
        reset_count = stats.get("reset_count", 0)
        if not isinstance(reset_count, int):
            reset_count = 0
        ernic_flr_reset_total.labels(
            instance=iid,
        ).set(reset_count)

        cmds = stats.get("commands", 0)
        if not isinstance(cmds, int):
            cmds = 0
        ernic_commands_total.labels(
            instance=iid,
        ).set(cmds)

        ints = stats.get("interrupts", 0)
        if not isinstance(ints, int):
            ints = 0
        ernic_interrupts_total.labels(
            instance=iid,
        ).set(ints)

        conn = stats.get("connection", "unknown")
        if not isinstance(conn, str):
            conn = str(conn)
        is_connected = 1 if conn.startswith(
            "connected"
        ) else 0
        ernic_connection_up.labels(
            instance=iid, state=conn,
        ).set(is_connected)

        # MMIO
        mmio_r = stats.get("mmio_reads_total", 0)
        mmio_w = stats.get("mmio_writes_total", 0)
        if not isinstance(mmio_r, int):
            mmio_r = 0
        if not isinstance(mmio_w, int):
            mmio_w = 0
        ernic_mmio_reads_total.labels(
            instance=iid,
        ).set(mmio_r)
        ernic_mmio_writes_total.labels(
            instance=iid,
        ).set(mmio_w)

        # Stats write count
        wc = stats.get("Write count", 0)
        if not isinstance(wc, int):
            wc = 0
        ernic_stats_writes_total.labels(
            instance=iid,
        ).set(wc)

        # Per-QP metrics
        ernic_qp_count.labels(
            instance=iid,
        ).set(len(qps))

        for qp_handle, qp_stats in qps.items():
            qp_label = str(qp_handle)

            def _qp_int(key):
                v = qp_stats.get(key, 0)
                return v if isinstance(v, int) else 0

            ernic_qp_bytes_sent_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("bytes_sent"))
            ernic_qp_bytes_received_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("bytes_received"))
            ernic_qp_bytes_rdma_read_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("bytes_rdma_read"))
            ernic_qp_bytes_rdma_write_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("bytes_rdma_write"))
            ernic_qp_wqes_processed_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("wqes_processed"))
            ernic_qp_cqes_posted_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("cqes_posted"))
            ernic_qp_doorbell_send_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("doorbell_send"))
            ernic_qp_doorbell_recv_total.labels(
                instance=iid, qp=qp_label,
            ).set(_qp_int("doorbell_recv"))

    ernic_vms_total.set(vm_count)


# ── HTTP handler ──────────────────────────────────

class MetricsHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/metrics":
            collect_metrics()
            output = generate_latest(registry)
            self.send_response(200)
            self.send_header(
                "Content-Type", CONTENT_TYPE_LATEST,
            )
            self.end_headers()
            self.wfile.write(output)
        elif self.path == "/":
            body = (
                b"<html><body>"
                b"<h1>ernic-exporter</h1>"
                b"<p><a href='/metrics'>Metrics</a></p>"
                b"</body></html>"
            )
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_error(404)

    def log_message(self, format, *args):
        sys.stderr.write(
            f"[ernic-exporter] {args[0]} "
            f"{args[1]} {args[2]}\n"
        )


# ── Main ──────────────────────────────────────────

def main():
    port = EXPORTER_PORT
    if len(sys.argv) > 1:
        try:
            port = int(sys.argv[1])
        except ValueError:
            print(
                f"Usage: {sys.argv[0]} [PORT]",
                file=sys.stderr,
            )
            sys.exit(1)

    server = HTTPServer(("", port), MetricsHandler)

    def shutdown_handler(signum, frame):
        print(
            "\n[ernic-exporter] Shutting down...",
            file=sys.stderr,
        )
        server.shutdown()

    signal.signal(signal.SIGTERM, shutdown_handler)
    signal.signal(signal.SIGINT, shutdown_handler)

    print(
        f"[ernic-exporter] Listening on"
        f" :{port}/metrics",
        file=sys.stderr,
    )
    print(
        f"[ernic-exporter] Reading stats from"
        f" {RUN_DIR}",
        file=sys.stderr,
    )

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()

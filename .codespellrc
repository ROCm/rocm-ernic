# codespell config file docs:
#    https://github.com/codespell-project/codespell#using-a-config-file

[codespell]
check-hidden = true

# ansible/.ansible is a local collection install, not ours and not in git;
# CI never sees it, so skipping keeps a local run honest.
# *.patch are verbatim upstream commits under patches/: correcting a typo
# in one would make it stop matching the series it was exported from, and
# every later rebase would have to carry the correction forward. The
# READMEs beside them are ours and stay checked.
skip = ./.git,./.claude/settings.local.json,./ansible/.ansible,*.patch

# AER is the NVMe Asynchronous Event Request, not a misspelling of "are".
# inout is a P4 parameter direction, used throughout tests/data/p4/src.
ignore-words-list = clen,VAs,TRIMed,AER,inout

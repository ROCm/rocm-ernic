# codespell config file docs:
#    https://github.com/codespell-project/codespell#using-a-config-file

[codespell]
check-hidden = true

# src/from-qemu is vendored upstream source. We can't fix typos there
# without carrying a patch, so don't let it fail CI.
skip = ./.git,./src/from-qemu,./.claude/settings.local.json

ignore-words-list = clen,VAs,TRIMed

# clang-tidy configuration for rocm-ernic
#
# Build with -DERNIC_USE_CLANG_TIDY=ON (and Clang as the C compiler) to
# run these checks. Every finding is an error.
#
# Whole groups are enabled, and individual checks are turned off below.
# Later entries override earlier ones. A group's C++ and Objective-C
# checks don't run on C code, so the groups are enabled whole, which also
# picks up the checks that a newer clang-tidy adds to them.
#
# This needs clang-tidy 19 or later, for ExcludeHeaderFilterRegex. CI
# (clang-tidy.yml) uses upstream clang-tidy 23.
#
# Some checks have more than one name (aliases), so a check that's turned
# off is listed under each of its names in the enabled groups. Each alias
# follows the check it's an alias of.
---
Checks:
  - -*
  # The android-cloexec checks apply to any Linux program, and
  # android-comparison-in-temp-failure-retry to glibc's TEMP_FAILURE_RETRY
  - android-*
  - bugprone-*
  - cert-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*

  # Not enabled, since they're for other platforms or code bases. The
  # checks named in parentheses report something in the current code:
  #   altera-*: OpenCL kernels for Intel FPGAs (altera-struct-pack-align,
  #     altera-unroll-loops)
  #   darwin-*: Apple's OSSpinLock and dispatch_once
  #   google-*: Google's style. Its checks for C are aliases of enabled
  #     ones, google-global-names-in-headers (C++ using-declarations), and
  #     google-readability-todo (TODO(username) comments).
  #     google-runtime-int, which hipObject enables, is C++ only
  #   linuxkernel-*: the kernel's ERR_PTR() convention
  #   llvm-*: LLVM's conventions (llvm-header-guard, llvm-include-order)
  #     and aliases of enabled checks
  #   llvmlibc-*: LLVM's C library (llvmlibc-restrict-system-libc-headers)
  #   mpi-*: MPI programs
  # abseil, boost, fuchsia, objc, openmp, and zircon have no checks that
  # run on C.

  # Not wanted: checks that contradict rocm-ernic's conventions or
  # tooling

  # IWYU checks the includes (iwyu.yml), as in hipObject
  - -misc-include-cleaner

  # TODO: These checks report problems in the current code. Fix the code
  # and delete the check's line here, or move it to "Not wanted" with a
  # reason. The count is the number of places clang-tidy 23 reports in
  # the Debug and Release builds together.
  - -bugprone-assignment-in-if-condition  # TODO(10)
  - -bugprone-branch-clone  # TODO(1)
  - -bugprone-easily-swappable-parameters  # TODO(326)
  - -bugprone-implicit-widening-of-multiplication-result  # TODO(90)
  - -bugprone-invalid-enum-default-initialization  # TODO(3)
  - -bugprone-multi-level-implicit-pointer-conversion  # TODO(5)
  - -bugprone-not-null-terminated-result  # TODO(1)
  - -bugprone-reserved-identifier  # TODO(2)
  - -cert-dcl37-c  # TODO: the same check
  # The same check, but it also reports the __real_ and __wrap_ functions
  # that the linker's --wrap option needs (10 of its 12)
  - -cert-dcl51-cpp  # TODO(12)
  - -bugprone-signed-bitwise  # TODO(779)
  - -bugprone-suspicious-memory-comparison  # TODO(6)
  - -cert-exp42-c  # TODO: the same check
  - -cert-flp37-c  # TODO: the same check
  - -cert-err33-c  # TODO(673): unchecked return values
  - -clang-analyzer-core.CallAndMessage  # TODO(9)
  - -clang-analyzer-core.NonNullParamChecker  # TODO(2)
  - -clang-analyzer-core.NullDereference  # TODO(1)
  - -clang-analyzer-optin.performance.Padding  # TODO(18)
  # Only reported in Release, and only with the other checks here off.
  # The analyzer follows paths through the code, so which problems it
  # finds can change with the set of checks
  - -clang-analyzer-optin.taint.TaintedAlloc  # TODO(1)
  - -clang-analyzer-security.ArrayBound  # TODO(2)
  # It wants C11's Annex K functions, such as memcpy_s(), which glibc
  # doesn't have
  - -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling  # TODO(1454)
  - -clang-analyzer-unix.Stream  # TODO(1)
  - -cppcoreguidelines-avoid-non-const-global-variables  # TODO(210)
  - -cppcoreguidelines-init-variables  # TODO(843)
  - -cppcoreguidelines-interfaces-global-init  # TODO(1)
  - -misc-no-recursion  # TODO(4)
  - -misc-predictable-rand  # TODO(2)
  - -cert-msc30-c  # TODO: the same check
  - -cert-msc50-cpp  # TODO: the same check
  - -misc-redundant-expression  # TODO(2)
  - -misc-unused-parameters  # TODO(86)
  - -misc-use-internal-linkage  # TODO(5)
  - -modernize-avoid-c-style-cast  # TODO(19)
  - -modernize-macro-to-enum  # TODO(1191)
  - -cppcoreguidelines-macro-to-enum  # TODO: the same check
  - -performance-no-int-to-ptr  # TODO(16)
  - -readability-avoid-nested-conditional-operator  # TODO(16)
  - -readability-braces-around-statements  # TODO(2820)
  - -readability-else-after-return  # TODO(4)
  - -readability-function-cognitive-complexity  # TODO(72)
  # hipObject turns this off
  - -readability-identifier-length  # TODO(3103)
  - -readability-implicit-bool-conversion  # TODO(466)
  - -readability-inconsistent-declaration-parameter-name  # TODO(2)
  - -readability-inconsistent-ifelse-braces  # TODO(5)
  - -readability-isolate-declaration  # TODO(225)
  - -readability-magic-numbers  # TODO(4073)
  - -cppcoreguidelines-avoid-magic-numbers  # TODO: the same check
  - -readability-math-missing-parentheses  # TODO(100)
  - -readability-redundant-casting  # TODO(5)
  - -readability-redundant-nested-if  # TODO(4)
  - -readability-redundant-parentheses  # TODO(2)
  - -readability-suspicious-call-argument  # TODO(2)
  - -readability-trailing-comma  # TODO(167)
  - -readability-uppercase-literal-suffix  # TODO(344)
  - -readability-use-concise-preprocessor-directives  # TODO(3)
WarningsAsErrors: '*'

CheckOptions:
  # rocm-ernic only builds with glibc, so report the functions that glibc
  # documents as thread-unsafe. The default adds POSIX's list, which
  # includes getenv() and dlerror(): glibc's getenv() only races with
  # changes to the environment, and its dlerror() keeps per-thread state.
  # Revisit this if rocm-ernic is built with another C library.
  concurrency-mt-unsafe.FunctionSet: glibc
  # The default, Remove, mistakes the comma after an empty {} argument for
  # a trailing comma, as in {a, b, {}, c}, and its fix doesn't compile.
  # Multi-line lists still need a trailing comma, which also keeps
  # clang-format from packing several elements onto a line
  readability-trailing-comma.SingleLineCommaPolicy: Ignore

# Report problems in every header that isn't a system header
HeaderFilterRegex: '.*'
SystemHeaders: false

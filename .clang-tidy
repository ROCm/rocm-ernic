# clang-tidy configuration for rocm-ernic
#
# Build with -DERNIC_USE_CLANG_TIDY=ON (and Clang as the C compiler) to
# run these checks. Every finding is an error.
#
# Whole groups are enabled, and individual checks are turned off below.
# Later entries override earlier ones. A group's C++ and Objective-C
# checks don't run on C code, so the groups are enabled whole, which also
# picks up the checks that a newer clang-tidy adds to them.
#
# This needs clang-tidy 19 or later, for ExcludeHeaderFilterRegex. CI
# (clang-tidy.yml) uses upstream clang-tidy 23.
#
# Some checks have more than one name (aliases), so a check that's turned
# off is listed under each of its names in the enabled groups. Each alias
# follows the check it's an alias of.
---
Checks:
  - -*
  # The android-cloexec checks apply to any Linux program, and
  # android-comparison-in-temp-failure-retry to glibc's TEMP_FAILURE_RETRY
  - android-*
  - bugprone-*
  - cert-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*

  # Not enabled, since they're for other platforms or code bases. The
  # checks named in parentheses report something in the current code:
  #   altera-*: OpenCL kernels for Intel FPGAs (altera-struct-pack-align,
  #     altera-unroll-loops)
  #   darwin-*: Apple's OSSpinLock and dispatch_once
  #   google-*: Google's style. Its checks for C are aliases of enabled
  #     ones, google-global-names-in-headers (C++ using-declarations), and
  #     google-readability-todo (TODO(username) comments).
  #     google-runtime-int, which hipObject enables, is C++ only
  #   linuxkernel-*: the kernel's ERR_PTR() convention
  #   llvm-*: LLVM's conventions (llvm-header-guard, llvm-include-order)
  #     and aliases of enabled checks
  #   llvmlibc-*: LLVM's C library (llvmlibc-restrict-system-libc-headers)
  #   mpi-*: MPI programs
  # abseil, boost, fuchsia, objc, openmp, and zircon have no checks that
  # run on C.

  # Not wanted: checks that contradict rocm-ernic's conventions or
  # tooling

  # IWYU checks the includes (iwyu.yml), as in hipObject
  - -misc-include-cleaner
  # It wants C11's Annex K functions, such as memcpy_s(), which glibc
  # doesn't have and rocm-ernic won't use
  - -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
  # Fields are ordered for the reader and for Clang's thread-safety
  # analysis, which wants each guarded field after its lock, and the
  # test-case tables lead with the same fields. The space it would save
  # is a few KB per device
  - -clang-analyzer-optin.performance.Padding
  # ibverbs and POSIX define their flags as int (IBV_QP_STATE | IBV_QP_PORT,
  # flags | O_CLOEXEC, revents & POLLIN), so combining them can only be
  # written with signed operands. It also reports signed shift counts and
  # parenthesised literals, which can't go wrong; UBSan reports a shift
  # that overflows
  - -bugprone-signed-bitwise
  # Short names such as fd, rc, ok, and n are idiomatic C. Even with those
  # allowed, and any short name last used within 25 lines of where it's
  # declared, it reports about a thousand renames that find no bugs.
  # hipObject turns it off too
  - -readability-identifier-length
  # A trailing comma after a multi-line list makes clang-format put one
  # element on each line, so a test-case table's row of a few lines
  # becomes one of a dozen or more. Its fix also adds a second comma to
  # an enumerator that already has one when a multi-line comment follows
  - -readability-trailing-comma

  # TODO: These checks report problems in the current code. Fix the code
  # and delete the check's line here, or move it to "Not wanted" with a
  # reason. The count is the number of places clang-tidy 23 reports in
  # the Debug and Release builds together.
  - -cert-err33-c  # TODO(780): unchecked return values
  - -cppcoreguidelines-avoid-non-const-global-variables  # TODO(249)
  - -cppcoreguidelines-init-variables  # TODO(1293)
  - -cppcoreguidelines-interfaces-global-init  # TODO(1)
  - -modernize-avoid-c-style-cast  # TODO(27)
  - -modernize-macro-to-enum  # TODO(1236)
  - -cppcoreguidelines-macro-to-enum  # TODO: the same check
  - -performance-no-int-to-ptr  # TODO(16)
  - -readability-function-cognitive-complexity  # TODO(35)
  - -readability-magic-numbers  # TODO(635)
  - -cppcoreguidelines-avoid-magic-numbers  # TODO: the same check
WarningsAsErrors: '*'

CheckOptions:
  # rocm-ernic only builds with glibc, so report the functions that glibc
  # documents as thread-unsafe. The default adds POSIX's list, which
  # includes getenv() and dlerror(): glibc's getenv() only races with
  # changes to the environment, and its dlerror() keeps per-thread state.
  # Revisit this if rocm-ernic is built with another C library.
  concurrency-mt-unsafe.FunctionSet: glibc
  # In C, &&, ||, and ! produce an int that's always 0 or 1, so assigning
  # one to a bool loses nothing. The option is new in clang-tidy 23; an
  # earlier one that runs this check on C reports these
  readability-implicit-bool-conversion.AllowLogicalOperatorConversion: true
  # Powers of two are sizes, alignments, field widths, and shift counts,
  # whose meaning the code around them makes clear
  readability-magic-numbers.IgnorePowersOf2IntegerValues: true
  # Count the function's own branches, not those in the macros it uses,
  # such as a test's check macros
  readability-function-cognitive-complexity.IgnoreMacros: true
  # Constants are mostly defined in macros, so check them too, or a
  # suffix's case would depend on where the literal is
  readability-uppercase-literal-suffix.IgnoreMacros: false
  # (tolower)(c) calls the function rather than glibc's macro, which
  # Clang reports as expanding recursively (see src/s3/s3_http.c)
  readability-redundant-parentheses.AllowedDecls: 'tolower;toupper'
  # C has no distinct types for same-typed parameters, so the fix is a
  # parameter struct. Report a run of four or more, where swapping two
  # arguments is easiest; two or three is most of the code's functions
  bugprone-easily-swappable-parameters.MinimumLength: 4

# Report problems in every header that isn't a system header
HeaderFilterRegex: '.*'
SystemHeaders: false

#
# The pins the CI guest image is built from, and the only place they
# live. ci/images/ensure-image.sh passes each to build.sh and check.sh in
# the environment, and ci/images/image-tag.sh hashes this file into the
# image's tag, so changing a pin here makes a new image.
#
# Plain KEY=VALUE, with no quoting, expansion or spaces around `=`:
# ensure-image.sh and image-tag.sh read it line by line.

# The Ubuntu release, by codename. build.sh boots its current cloud image
# (cloud-images.ubuntu.com/RELEASE/current/), and records which in
# vm-info.json.
RELEASE=resolute

# The kernel the guest boots: an Ubuntu mainline build
# (kernel.ubuntu.com/mainline/KERNEL_REF/), since no release ships one
# new enough. It must equal IONIC_KERNEL_REF in
# cmake/ErnicKernelModule.cmake, the ionic sources the lanes build into
# the guest, and `image-tag.sh --check` fails until it does.
KERNEL_REF=v7.2.6

# The rdma-core the release packages, which provision/ionic.sh asserts
# and records for the Ansible roles. It moves with RELEASE, never alone.
RDMA_CORE_VERSION=61.0

# The disk's name, without .qcow2, and its size in GiB: the most the
# guest's filesystem can grow to, since the disk is sparse
VM_NAME=ubuntu-ci-vm
VM_SIZE=512

# The default user of Ubuntu's cloud images, which every boot's seed
# authorizes a key for, and which keeps its passwordless sudo. build.sh
# fails unless the image's default user has this name.
USERNAME=ubuntu

# Bump to rebuild the image when nothing else changed, to pick up a newer
# cloud image and Ubuntu's updates
REBUILD=1

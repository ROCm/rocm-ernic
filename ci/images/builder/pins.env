#
# The pins the CI builder image is built from, and the only place they
# live. ci/images/ensure-image.sh passes each to the Dockerfile as a build
# argument, and ci/images/image-tag.sh hashes this file into the image's
# tag, so changing a pin here makes a new image.
#
# LIBVFIO_USER_REPO and LIBVFIO_USER_COMMIT are also what every other CI
# build compiles the server against (build-and-test.yml, clang-tidy.yml,
# codeql.yml, ...), so the VM lanes and the unit tests can't drift onto
# different libvfio-user commits.
#
# Plain KEY=VALUE, with no quoting, expansion or spaces around `=`: shell
# sources it and ensure-image.sh reads it line by line.

# The base image, ubuntu:UBUNTU: the release the rest of CI builds on,
# so the lanes compile the server with the same GCC
UBUNTU=26.04

# A tag (vX.Y.Z) or a full commit SHA
QEMU_REPO=https://gitlab.com/qemu-project/qemu.git
QEMU_COMMIT=v11.1.1

# A full commit SHA. 5b9c722 is the first that keeps the upper half of a
# small 64-bit BAR writable, so a guest can place BAR0 and BAR2 above
# 4 GiB.
LIBVFIO_USER_REPO=https://github.com/nutanix/libvfio-user.git
LIBVFIO_USER_COMMIT=5b9c7220647e45a0bbfc2a22bef05bbfd56e5742

# oras doesn't ship in Ubuntu, so it's the upstream static binary, checked
# against this SHA-256. Bump both together.
ORAS_VERSION=1.3.4
ORAS_SHA256=f27adb935022d94df8dc77719c322dda592c78a0d57a6f7dcdd8d900b248c454

ANSIBLE_CORE_VERSION=2.21.4

# Bump to rebuild the image when nothing else changed, to pick up the
# base image's and Ubuntu's updates
REBUILD=1

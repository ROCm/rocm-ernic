# The guest qcow2 every lane boots, and the builder container the lanes run
# in. THIS IS THE ONLY PLACE THEIR TAGS LIVE.
#
# It used to be copied into five: ansible/group_vars/all.yml, ci/lib/common.sh,
# and the nvmeof, s3 and system-tests workflows. Each copy carried a comment
# telling the next person to keep it equal to the others, which is the usual
# sign that nothing enforces it -- a bump that missed one lane would have that
# lane silently testing a different guest, and the failure would look like a
# flaky backend rather than a stale image.
#
# The format is deliberately plain KEY=VALUE so shell, GitHub Actions and
# Ansible can all read it without a parser:
#
#   shell            . ci/guest-image.env
#   GitHub Actions   grep -E '^[A-Za-z_][A-Za-z0-9_]*=' ci/guest-image.env
#                      >> "$GITHUB_ENV"
#   Ansible          lookup('ansible.builtin.ini', '<key> type=properties
#                           file=.../ci/guest-image.env')
#
# so keep it to KEY=VALUE with no quoting, expansion or spaces around `=`.
# tools/check-guest-image-tag.sh fails the build if a literal tag reappears
# anywhere else.
#
# The grep in the Actions recipe is not decoration: $GITHUB_ENV rejects any
# line that is not an assignment, so cat'ing this file whole fails the step on
# its first comment line -- and the KEY=VALUE mentioned two lines up would
# otherwise be read as one.
#
# The guest every VM lane boots, defined in ci/images/guest/ and published
# as an OCI artifact: the zstd-compressed disk, with vm-info.json attached
# as a referrer of type GUEST_ARTIFACT_INFO_TYPE. Its tag names its
# contents, as the builder's does, and `image-tag.sh --write guest` updates
# the repository, tag, disk and account here, which change with it.
# scripts/fetch-guest-image.sh pulls it by these, and takes --expect-disk
# and --expect-user to refuse an image whose vm-info.json says otherwise.
#
# The image has no password and no key: ci/boot-guest.sh authorizes a key
# for GUEST_ARTIFACT_USER at each boot.
GUEST_ARTIFACT_REPO=ghcr.io/rocm/rocm-ernic/guest-ionic
GUEST_ARTIFACT_TAG=resolute-k7.2.6-349eb8bf926f
GUEST_ARTIFACT_INFO_TYPE=application/vnd.rocm-ernic.vm-info.v1
GUEST_ARTIFACT_DISK=ubuntu-ci-vm.qcow2
GUEST_ARTIFACT_USER=ubuntu

# The builder container every VM lane runs in, defined in ci/images/builder/.
# Its tag names its contents, so it changes with any change there; then
# ci/images/image-tag.sh --check fails until `image-tag.sh --write builder`
# updates these two lines. The lanes' container image: lines name it too,
# written out for the security scan, which can't see that an image named
# by an expression is pinned; --write updates them with these, and --check
# and tools/check-guest-image-tag.sh fail if one disagrees.
BUILDER_IMAGE=ghcr.io/rocm/rocm-ernic/ci-builder
BUILDER_TAG=qemu11.1.1-vfu.5b9c722-4b1ea0f67493

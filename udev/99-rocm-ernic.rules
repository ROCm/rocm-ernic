#
# rocm-ernic persistent device naming rules.
#
# Renames network interfaces and InfiniBand devices
# created by the rocm_ernic driver to stable names.
#
# Install with:
#   sudo cp udev/99-rocm-ernic.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger

# --- Network interface naming ---
#
# Renames the Ethernet interface from the default
# PCI-topology name (e.g. enp1s0) to rocm-ernic0.
# DRIVERS guard prevents matching other AMD devices.

SUBSYSTEM=="net", ACTION=="add", \
  ATTR{device/vendor}=="0x1022", \
  DRIVERS=="rocm_ernic", \
  NAME="rocm-ernic%n"

# --- InfiniBand device naming ---
#
# Renames the RDMA device from the default
# PCI-topology name (e.g. rocep1s0) to
# rocm-rdma-ernic0.  The rename is deferred via a
# backgrounded subshell because rdma-netlink calls
# from a synchronous udev RUN can fail while the
# device is still settling.

SUBSYSTEM=="infiniband", ACTION=="add", \
  DRIVERS=="rocm_ernic", \
  ATTRS{vendor}=="0x1022", \
  RUN+="/bin/sh -c '(sleep 1; \
    /usr/bin/rdma dev set %k \
    name rocm-rdma-ernic%n) &'"

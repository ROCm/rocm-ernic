#
# rocm-ernic persistent device naming rules.
#
# Renames network interfaces and InfiniBand devices
# created by rocm-ernic (1dd8:100a, upstream ionic driver)
# to stable names, so guests always see rocm-ernic<n> and
# rocm-rdma-ernic<n>.
#
# Install with:
#   sudo cp udev/99-rocm-ernic.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger

# --- Network interface naming ---
#
# Renames the Ethernet interface from the default
# PCI-topology name (e.g. enp1s0) to rocm-ernic0.
# The device-ID guard is what keeps this off real
# Pensando hardware, which the same driver also binds.

SUBSYSTEM=="net", ACTION=="add", \
  ATTR{device/vendor}=="0x1dd8", \
  ATTR{device/device}=="0x100a", \
  DRIVERS=="ionic", \
  NAME="rocm-ernic%n"

# --- InfiniBand device naming ---
#
# Renames the RDMA device from the PCI-topology
# name (e.g. rocep2s0) to rocm-rdma-ernic<n>.
#
# The system rule 60-rdma-persistent-naming.rules
# renames the device from its kernel-registered
# name (ionic_%d) to a PCI-topology
# name via rdma_rename before this rule runs, so
# %k is stale by the time we see it.  The PCI part
# of $devpath is not: the sysfs directory moves
# with the rename but its parent does not, so
# $pci/infiniband/ always lists the device's
# current name.  That is also what makes this rule
# act only on the device the event is about --
# the old version scanned all of
# /sys/class/infiniband for the emulated vendor and
# renamed every match to the same hard-coded
# rocm-rdma-ernic0, so a guest with two emulated
# devices had the second rename fail.
#
# Reading the current name this way also removes
# the reason for the old "(sleep 2; ...) &": udev
# runs 60- before 99- within one event, so
# rdma_rename has already happened and there is
# nothing to wait for.  Backgrounding it meant the
# rename completed some seconds after udev settled,
# which a caller checking for the device could
# lose a race against.
#
# The rocm-rdma-ernic* guard makes this idempotent
# -- without it a re-triggered event would rename
# an already-correct device to the next free index.

SUBSYSTEM=="infiniband", ACTION=="add", \
  DRIVERS=="ionic|ionic_rdma", \
  ATTRS{vendor}=="0x1dd8", \
  ATTRS{device}=="0x100a", \
  RUN+="/bin/sh -c 'pci=/sys$devpath; pci=${pci%/infiniband/*}; \
    for ibdev in $pci/infiniband/*; do \
      [ -d $ibdev ] || continue; \
      cur=${ibdev##*/}; \
      case $cur in rocm-rdma-ernic*) continue;; esac; \
      i=0; \
      while [ -e /sys/class/infiniband/rocm-rdma-ernic$i ]; do \
        i=$((i+1)); \
      done; \
      /usr/bin/rdma dev set $cur name rocm-rdma-ernic$i; \
    done'"

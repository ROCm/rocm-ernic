---
# .ansible-lint
# See https://ansible-lint.readthedocs.io/configuring/

exclude_paths:
  - roles/*/tests
  - collections/  # local ansible-galaxy installs
  # Generated by antsibull-changelog; its indentation style is not
  # the one yamllint wants and rewriting it would be undone by the
  # next release run.
  - changelogs/changelog.yaml

# CI runs with --strict, so a rule left on the warn list fails it
# anyway. A rule that can't be met goes here, with the reason.
skip_list:
  # The ernic_* prefix predates the split into roles and is used
  # by the test playbooks and ci/jobs/*.sh, and some variables,
  # such as ernic_source_dir, are shared by two roles on purpose;
  # keeping it beats renaming every consumer to
  # ernic_guest_setup_*.
  - var-naming[no-role-prefix]

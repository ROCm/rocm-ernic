# Environment file for rocm-ernic systemd service.
# Sourced by systemd EnvironmentFile= and by
# rocm-ernic-launcher when run standalone.
#
# Install location: /etc/rocm-ernic/rocm-ernic.env
#
# This file is managed by Ansible.  Manual edits will
# be overwritten on the next playbook run.

# ── Server binary and directories ──────────────────
ERNIC_BIN={{ ernic_bin }}
ERNIC_RUN_DIR={{ ernic_run_dir }}
ERNIC_LOG_DIR={{ ernic_log_dir }}

# ── Instance configuration ─────────────────────────
# Total instance count. Instance 1 is the TCP manager;
# instances 2..N are workers.
ERNIC_INSTANCES={{ ernic_instances }}

# TCP backend mesh settings (manager <-> workers).
ERNIC_TCP_PORT={{ ernic_tcp_port }}
ERNIC_MANAGER_IP={{ ernic_manager_ip }}

# Enable verbose server logging (true / false).
ERNIC_VERBOSE={{ ernic_verbose }}

# ── MAC addresses ──────────────────────────────────
# Per-instance MAC overrides.  Leave unset for
# deterministic MACs derived from /etc/machine-id.
{% if ernic_mac_overrides is defined %}
{% for idx, mac in ernic_mac_overrides.items() %}
ERNIC_MAC_{{ idx }}={{ mac }}
{% endfor %}
{% else %}
#ERNIC_MAC_1=aa:bb:cc:dd:ee:01
#ERNIC_MAC_2=aa:bb:cc:dd:ee:02
{% endif %}

# ── Driver distribution ───────────────────────────
ERNIC_DRIVER_SOURCE={{ ernic_driver_source }}
ERNIC_DRIVER_TARBALL={{ ernic_driver_tarball }}

# ── QEMU / VM defaults ────────────────────────────
ERNIC_QEMU_MINIMAL={{ ernic_qemu_minimal }}
ERNIC_QEMU_PATH={{ ernic_qemu_path }}
ERNIC_VM_IMAGE_DIR={{ ernic_vm_image_dir }}
ERNIC_VM_NAME={{ ernic_vm_name }}
ERNIC_VM_VCPUS={{ ernic_vm_vcpus }}
ERNIC_VM_MEM={{ ernic_vm_mem }}
ERNIC_VM_SSH_USER={{ ernic_vm_ssh_user }}
ERNIC_VM_SSH_BASE_PORT={{ ernic_vm_ssh_base_port }}

# Golden backing qcow2.  When set and a per-instance
# overlay does not exist, ernicctl vm-launch creates
# one automatically via qemu-img.
{% if ernic_vm_backing is defined %}
ERNIC_VM_BACKING={{ ernic_vm_backing }}
{% else %}
#ERNIC_VM_BACKING=/opt/qemu-images/backing/example-backing.qcow2
{% endif %}

# QEMU UDP multicast group for inter-VM L2 networking.
# When set, each VM gets a second virtio-net NIC on
# this shared segment (run-vm MCAST_GROUP feature).
{% if ernic_vm_mcast_group is defined %}
ERNIC_VM_MCAST_GROUP={{ ernic_vm_mcast_group }}
{% else %}
#ERNIC_VM_MCAST_GROUP=230.0.0.1:1234
{% endif %}

+
+_Atomic long seq_received = 0;
+
+void seq_stamp (char *buf, int msg_size, uint64_t seq)
+{
+    memcpy (buf, &seq, sizeof(seq));
+    memcpy (buf + msg_size - sizeof(seq), &seq, sizeof(seq));
+}
+
+/* 8 aligned bytes, read in one load */
+static uint64_t seq_word (volatile char *p)
+{
+    return *(volatile uint64_t *) p;
+}
+
+/*
+ * Wait for the message at msg, then check that it is number want. Both of
+ * its ends must have landed, since the order a WRITE's bytes land in isn't
+ * defined. Ends that both name another message are reported at once. Ends
+ * that disagree, one of them perhaps not landed yet, get 100 ms to finish
+ * landing first.
+ */
+int seq_wait (volatile char *msg, int msg_size, uint64_t want)
+{
+    volatile char   *end  = msg + msg_size - sizeof(uint64_t);
+    uint64_t         head = 0, tail = 0;
+    struct timespec  since, now;
+
+    do {
+	head = seq_word (msg);
+	tail = seq_word (end);
+    } while (head == 0 && tail == 0);
+
+    clock_gettime (CLOCK_MONOTONIC, &since);
+    while ((head != want || tail != want) && head != tail) {
+	clock_gettime (CLOCK_MONOTONIC, &now);
+	if ((now.tv_sec - since.tv_sec) * 1000000000L +
+	    (now.tv_nsec - since.tv_nsec) > 100000000L) {
+	    break;
+	}
+	head = seq_word (msg);
+	tail = seq_word (end);
+    }
+    if (head != want || tail != want) {
+	log_err ("expected message %" PRIu64 ", but its first 8 bytes say "
+		 "%" PRIu64 " and its last 8 %" PRIu64,
+		 want, head, tail);
+	return -1;
+    }
+
+    atomic_fetch_add (&seq_received, 1);
+    return 0;
+}
+
+/* Append n in decimal to buf at *len: snprintf isn't async-signal-safe */
+static void seq_append_num (char *buf, size_t *len, long n)
+{
+    char   digits[24];
+    size_t i = 0;
+
+    do {
+	digits[i++] = (char)('0' + n % 10);
+	n /= 10;
+    } while (n > 0 && i < sizeof(digits));
+    while (i > 0) {
+	buf[(*len)++] = digits[--i];
+    }
+}
+
+static void seq_append_str (char *buf, size_t *len, const char *s)
+{
+    size_t n = strlen (s);
+
+    memcpy (buf + *len, s, n);
+    *len += n;
+}
+
+/* Say how far the run got, as timeout(1) stops it */
+static void seq_on_signal (int sig)
+{
+    char    buf[128];
+    size_t  len = 0;
+    ssize_t ret;
+
+    seq_append_str (buf, &len, "rdma-tutorial: stopped by signal ");
+    seq_append_num (buf, &len, sig);
+    seq_append_str (buf, &len, " after receiving ");
+    seq_append_num (buf, &len, atomic_load (&seq_received));
+    seq_append_str (buf, &len, " of ");
+    seq_append_num (buf, &len, TOT_NUM_OPS);
+    seq_append_str (buf, &len, " messages\n");
+    ret = write (STDERR_FILENO, buf, len);
+    (void) ret;
+    _exit (128 + sig);
+}
+
+void seq_report_on_signal (void)
+{
+    struct sigaction sa;
+
+    memset (&sa, 0, sizeof(sa));
+    sa.sa_handler = seq_on_signal;
+    sigemptyset (&sa.sa_mask);
+    sigaction (SIGTERM, &sa, NULL);
+    sigaction (SIGINT, &sa, NULL);
+}

 drivers/net/ethernet/pensando/ionic/ionic_stats.c |   3 +
 drivers/net/ethernet/pensando/ionic/ionic_txrx.c  | 123 +++++++++++++++++++--
 3 files changed, 118 insertions(+), 10 deletions(-)


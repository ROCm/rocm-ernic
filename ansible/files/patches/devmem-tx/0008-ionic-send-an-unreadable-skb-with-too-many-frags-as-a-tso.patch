index 3cca0bda1d77..f69d4c07cc1c 100644
--- a/drivers/net/ethernet/pensando/ionic/ionic_lif.h
+++ b/drivers/net/ethernet/pensando/ionic/ionic_lif.h
@@ -40,6 +40,7 @@ struct ionic_tx_stats {
 	u64 hwstamp_invalid;
 	u64 xdp_frames;

 };
 
 static const struct ionic_stat_desc ionic_port_stats_desc[] = {
@@ -144,6 +145,7 @@ static const struct ionic_stat_desc ionic_tx_stats_desc[] = {
 	IONIC_TX_STAT_DESC(vlan_inserted),
 	IONIC_TX_STAT_DESC(xdp_frames),

diff --git a/drivers/net/ethernet/pensando/ionic/ionic_txrx.c b/drivers/net/ethernet/pensando/ionic/ionic_txrx.c
index c568ffb05706..59eb619d777e 100644
--- a/drivers/net/ethernet/pensando/ionic/ionic_txrx.c
+++ b/drivers/net/ethernet/pensando/ionic/ionic_txrx.c
@@ -1441,7 +1441,7 @@ static void ionic_tx_tso_post(struct net_device *netdev, struct ionic_queue *q,
 }
 
 static int ionic_tx_tso(struct net_device *netdev, struct ionic_queue *q,
-			struct sk_buff *skb)
+			struct sk_buff *skb, unsigned int mss)
 {
 	struct ionic_tx_stats *stats = q_to_tx_stats(q);
 	struct ionic_tx_desc_info *desc_info;
@@ -1456,7 +1456,6 @@ static int ionic_tx_tso(struct net_device *netdev, struct ionic_queue *q,
 	dma_addr_t frag_addr;
 	unsigned int hdrlen;
 	unsigned int len;
-	unsigned int mss;
 	bool start, done;
 	bool outer_csum;
 	bool has_vlan;
@@ -1487,7 +1486,6 @@ static int ionic_tx_tso(struct net_device *netdev, struct ionic_queue *q,
 		return -EIO;
 
 	len = skb->len;
-	mss = skb_shinfo(skb)->gso_size;
 	outer_csum = (skb_shinfo(skb)->gso_type & (SKB_GSO_GRE |
 						   SKB_GSO_GRE_CSUM |
 						   SKB_GSO_IPXIP4 |
@@ -1559,6 +1557,9 @@ static int ionic_tx_tso(struct net_device *netdev, struct ionic_queue *q,
 	stats->bytes += len;
 	stats->tso++;
 	stats->tso_bytes = len;
+	/* only ionic_tx_unreadable_reseg() picks an mss of its own */
+	if (unlikely(mss != skb_shinfo(skb)->gso_size))
+		stats->unreadable_reseg++;
 
 	return 0;
 }
@@ -1700,7 +1701,101 @@ static int ionic_tx(struct net_device *netdev, struct ionic_queue *q,
 	return 0;
 }
 
-static int ionic_tx_descs_needed(struct ionic_queue *q, struct sk_buff *skb)
+/* An unreadable skb with more frags in one packet than a descriptor has
+ * buffers can't be linearized.  If it is plain TCP and the device does TSO,
+ * it can go out as a TSO with an mss small enough that every descriptor
+ * fits, which makes more and shorter segments of the same byte stream and
+ * leaves the skb, and the shinfo it shares with the socket's copy, alone.
+ *
+ * A descriptor that takes more than max_sg_elems + 1 buffers has
+ * max_sg_elems whole frags in the middle and at least a byte on both
+ * sides, and the first, which also has the headers, has the first
+ * max_sg_elems frags and a byte more.  So no descriptor does when the mss
+ * is no more than the shortest run of max_sg_elems frags.
+ *
+ * Returns the number of descriptors and sets @mss, or a negative errno if
+ * the skb can't be sent this way.
+ */
+static int ionic_tx_unreadable_reseg(struct ionic_queue *q,
+				     struct sk_buff *skb, unsigned int *mss)
+{
+	const struct skb_shared_info *shinfo = skb_shinfo(skb);
+	netdev_features_t tso;
+	unsigned int payload;
+	unsigned int hdrlen;
+	unsigned int ndescs;
+	unsigned int size;
+	unsigned int run;
+	unsigned int m;
+	unsigned int i;
+
+	if (ionic_txq_hwstamp_enabled(q) || skb->encapsulation)
+		return -EOPNOTSUPP;
+
+	/* TCP, with its headers and nothing else in the linear area */
+	if (skb->ip_summed != CHECKSUM_PARTIAL ||
+	    !skb_transport_header_was_set(skb) ||
+	    skb_checksum_start_offset(skb) != skb_transport_offset(skb) ||
+	    skb->csum_offset != offsetof(struct tcphdr, check) ||
+	    skb_headlen(skb) < skb_transport_offset(skb) + sizeof(struct tcphdr))
+		return -EOPNOTSUPP;
+
+	hdrlen = skb_tcp_all_headers(skb);
+	if (skb_headlen(skb) != hdrlen)
+		return -EOPNOTSUPP;
+
+	/* The device numbers the segments' IPv4 IDs from the header's, and
+	 * the stack did not set as many aside, so they must not matter.
+	 */
+	if (skb->protocol == cpu_to_be16(ETH_P_IP)) {
+		if (ip_hdr(skb)->protocol != IPPROTO_TCP ||
+		    ip_hdr(skb)->frag_off != cpu_to_be16(IP_DF))
+			return -EOPNOTSUPP;
+		tso = NETIF_F_TSO;
+	} else if (skb->protocol == cpu_to_be16(ETH_P_IPV6)) {
+		if (ipv6_hdr(skb)->nexthdr != IPPROTO_TCP)
+			return -EOPNOTSUPP;
+		tso = NETIF_F_TSO6;
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	/* The device repeats the header's flags, but for FIN, PSH and CWR */
+	if (tcp_hdr(skb)->syn || tcp_hdr(skb)->rst || tcp_hdr(skb)->urg)
+		return -EOPNOTSUPP;
+	if (tcp_hdr(skb)->cwr)
+		tso |= NETIF_F_TSO_ECN;
+
+	if ((q->lif->netdev->features & tso) != tso)
+		return -EOPNOTSUPP;
+
+	payload = skb->len - hdrlen;
+	m = skb_is_gso(skb) ? shinfo->gso_size : payload;
+	run = 0;
+	for (i = 0; i < shinfo->nr_frags; i++) {
+		size = skb_frag_size(&shinfo->frags[i]);
+		if (unlikely(!size))
+			return -EINVAL;
+
+		run += size;
+		if (i >= q->max_sg_elems)
+			run -= skb_frag_size(&shinfo->frags[i - q->max_sg_elems]);
+		if (i + 1 >= q->max_sg_elems)
+			m = min(m, run);
+	}
+
+	/* Short frags among long ones can ask for a very small mss */
+	ndescs = DIV_ROUND_UP(payload, m);
+	if (ndescs > q->num_descs / 2)
+		return -E2BIG;
+
+	*mss = m;
+
+	return ndescs;
+}
+
+static int ionic_tx_descs_needed(struct ionic_queue *q, struct sk_buff *skb,
+				 unsigned int *mss)
 {
 	int nr_frags = skb_shinfo(skb)->nr_frags;
 	bool too_many_frags = false;
@@ -1724,6 +1819,9 @@ static int ionic_tx_descs_needed(struct ionic_queue *q, struct sk_buff *skb)
 	if (unlikely(!skb_frags_readable(skb) && !nr_frags))
 		return -EFAULT;
 
+	/* A TSO, unless this is zero */
+	*mss = skb_shinfo(skb)->gso_size;
+
 	/* Each desc is mss long max, so a descriptor for each gso_seg */
 	if (skb_is_gso(skb)) {
 		ndescs = skb_shinfo(skb)->gso_segs;
@@ -1788,6 +1886,9 @@ static int ionic_tx_descs_needed(struct ionic_queue *q, struct sk_buff *skb)
 
 linearize:
 	if (too_many_frags) {
+		if (unlikely(!skb_frags_readable(skb)))
+			return ionic_tx_unreadable_reseg(q, skb, mss);
+
 		err = skb_linearize(skb);
 		if (unlikely(err))
 			return err;
@@ -1812,6 +1913,7 @@ static netdev_tx_t ionic_start_hwstamp_xmit(struct sk_buff *skb,
 {
 	struct ionic_lif *lif = netdev_priv(netdev);
 	struct ionic_queue *q;
+	unsigned int mss;
 	int err, ndescs;
 
 	/* Does not stop/start txq, because we post to a separate tx queue
@@ -1820,7 +1922,7 @@ static netdev_tx_t ionic_start_hwstamp_xmit(struct sk_buff *skb,
 	 */
 
 	q = &lif->hwstamp_txq->q;
-	ndescs = ionic_tx_descs_needed(q, skb);
+	ndescs = ionic_tx_descs_needed(q, skb, &mss);
 	if (unlikely(ndescs < 0))
 		goto err_out_drop;
 
@@ -1828,8 +1930,8 @@ static netdev_tx_t ionic_start_hwstamp_xmit(struct sk_buff *skb,
 		goto err_out_drop;
 
 	skb_shinfo(skb)->tx_flags |= SKBTX_HW_TSTAMP;
-	if (skb_is_gso(skb))
-		err = ionic_tx_tso(netdev, q, skb);
+	if (mss)
+		err = ionic_tx_tso(netdev, q, skb, mss);
 	else
 		err = ionic_tx(netdev, q, skb);
 
@@ -1847,6 +1949,7 @@ netdev_tx_t ionic_start_xmit(struct sk_buff *skb, struct net_device *netdev)
 	u16 queue_index = skb_get_queue_mapping(skb);
 	struct ionic_lif *lif = netdev_priv(netdev);
 	struct ionic_queue *q;
+	unsigned int mss;
 	int ndescs;
 	int err;
 
@@ -1863,7 +1966,7 @@ netdev_tx_t ionic_start_xmit(struct sk_buff *skb, struct net_device *netdev)
 		queue_index = 0;
 	q = &lif->txqcqs[queue_index]->q;
 
-	ndescs = ionic_tx_descs_needed(q, skb);
+	ndescs = ionic_tx_descs_needed(q, skb, &mss);
 	if (ndescs < 0)
 		goto err_out_drop;
 
@@ -1872,8 +1975,8 @@ netdev_tx_t ionic_start_xmit(struct sk_buff *skb, struct net_device *netdev)
 				  ndescs, ndescs))
 		return NETDEV_TX_BUSY;
 
-	if (skb_is_gso(skb))
-		err = ionic_tx_tso(netdev, q, skb);
+	if (mss)
+		err = ionic_tx_tso(netdev, q, skb, mss);
 	else
 		err = ionic_tx(netdev, q, skb);
 

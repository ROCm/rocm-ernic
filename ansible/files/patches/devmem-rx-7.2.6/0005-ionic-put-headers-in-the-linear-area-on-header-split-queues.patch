+static int ionic_rxq_pools_create(struct ionic_lif *lif, struct ionic_qcq *qcq,
+				  unsigned int num_descs,
+				  struct bpf_prog *xdp_prog)
+{
+	struct page_pool_params pp_params = {
+		.flags = PP_FLAG_DMA_MAP | PP_FLAG_DMA_SYNC_DEV,
+		.order = 0,
+		.pool_size = num_descs,
+		.nid = NUMA_NO_NODE,
+		.dev = lif->ionic->dev,
+		.napi = &qcq->napi,
+		.dma_dir = DMA_FROM_DEVICE,
+		.max_len = PAGE_SIZE,
+		.netdev = lif->netdev,
+	};
+	struct page_pool *pool;
+
+	if (xdp_prog)
+		pp_params.dma_dir = DMA_BIDIRECTIONAL;
+
+	pool = page_pool_create(&pp_params);
+	if (IS_ERR(pool)) {
+		netdev_err(lif->netdev, "Cannot create page_pool\n");
+		return PTR_ERR(pool);
+	}
+	qcq->q.page_pool = pool;
+
+	if (!(qcq->q.features & IONIC_RXQ_F_HDS))
+		return 0;
+
+	/* The headers are copied out of their buffers, which are small, so
+	 * this pool only ever holds a few pages.
+	 */
+	pp_params.pool_size = DIV_ROUND_UP(num_descs,
+					   PAGE_SIZE / IONIC_HDS_HDR_BUF_LEN);
+
+	pool = page_pool_create(&pp_params);
+	if (IS_ERR(pool)) {
+		netdev_err(lif->netdev, "Cannot create header page_pool\n");
+		page_pool_destroy(qcq->q.page_pool);
+		qcq->q.page_pool = NULL;
+		return PTR_ERR(pool);
+	}
+	qcq->q.hdr_pool = pool;
+
+	return 0;
+}

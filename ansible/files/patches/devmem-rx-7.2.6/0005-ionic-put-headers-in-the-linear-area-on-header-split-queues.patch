+/* Build the skb of a packet received on a header split queue.  What the
+ * device wrote to the descriptor's own buffer, which is the headers if it
+ * split the packet, is copied to the linear area, and the buffers of the SG
+ * elements become the frags.  Those can be net_iovs, so nothing here may
+ * look into them.
+ */
+static struct sk_buff *ionic_rx_build_hds_skb(struct net_device *netdev,
+					      struct ionic_queue *q,
+					      struct ionic_rx_desc_info *desc_info,
+					      struct ionic_rxq_comp *comp,
+					      unsigned int len)
+{
+	struct ionic_rx_stats *stats = q_to_rx_stats(q);
+	unsigned int num_sg_elems = comp->num_sg_elems;
+	struct ionic_rxq_comp_ext *ext;
+	struct ionic_buf_info *buf_info;
+	unsigned int remain_len;
+	unsigned int frag_len;
+	unsigned int hdr_len;
+	struct sk_buff *skb;
+	unsigned int i;
+
+	ext = (void *)comp - IONIC_HDS_CQ_NEGOFFSET;
+	hdr_len = le16_to_cpu(ext->hds_hdr_len);
+
+	/* Check what the device says against what it was given, before
+	 * anything is taken from the descriptor.  The buffers of a packet
+	 * that is dropped stay where they are, to be posted again.
+	 */
+	buf_info = &desc_info->bufs[0];
+	if (unlikely(hdr_len < ETH_HLEN || hdr_len > len ||
+		     hdr_len > IONIC_HDS_HDR_BUF_LEN ||
+		     num_sg_elems >= desc_info->nbufs ||
+		     !buf_info->netmem))
+		return NULL;
+
+	remain_len = len - hdr_len;
+	for (i = 1; i <= num_sg_elems; i++) {
+		buf_info = &desc_info->bufs[i];
+		if (unlikely(!buf_info->netmem || !remain_len))
+			return NULL;
+		remain_len -= min(remain_len, buf_info->len);
+	}
+	if (unlikely(remain_len))
+		return NULL;
+
+	/* Without the split there is more than TCP payload in the SG
+	 * buffers, and if those can't be read the stack can't parse the
+	 * packet.
+	 */
+	if (!(ext->hds_flags & IONIC_RXQ_COMP_HDS_F_SPLIT) && num_sg_elems &&
+	    page_pool_is_unreadable(q->page_pool)) {
+		stats->unreadable_drop++;
+		return NULL;
+	}
+
+	skb = napi_alloc_skb(&q_to_qcq(q)->napi, hdr_len);
+	if (unlikely(!skb)) {
+		net_warn_ratelimited("%s: SKB alloc failed on %s!\n",
+				     dev_name(q->dev), q->name);
+		stats->alloc_err++;
+		return NULL;
+	}
+	skb_mark_for_recycle(skb);
+
+	buf_info = &desc_info->bufs[0];
+	page_pool_dma_sync_netmem_for_cpu(q->hdr_pool, buf_info->netmem,
+					  buf_info->page_offset, hdr_len);
+	skb_copy_to_linear_data(skb, ionic_rx_buf_va(buf_info), hdr_len);
+	skb_put(skb, hdr_len);
+	__ionic_rx_put_buf(q->hdr_pool, buf_info, true);
+
+	remain_len = len - hdr_len;
+	for (i = 1; i <= num_sg_elems; i++) {
+		buf_info = &desc_info->bufs[i];
+		frag_len = min(remain_len, buf_info->len);
+		ionic_rx_add_skb_frag(q, skb, buf_info, 0, frag_len, false);
+		remain_len -= frag_len;
+	}
+
+	skb->protocol = eth_type_trans(skb, netdev);
+
+	if (ext->hds_flags & IONIC_RXQ_COMP_HDS_F_SPLIT)
+		stats->hds_split++;
+	else if (ext->hds_flags & IONIC_RXQ_COMP_HDS_F_HBO)
+		stats->hds_hbo++;
+
+	return skb;
+}

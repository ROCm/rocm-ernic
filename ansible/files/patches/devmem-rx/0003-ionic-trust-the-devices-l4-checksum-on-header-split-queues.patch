diff --git a/drivers/net/ethernet/pensando/ionic/ionic_txrx.c b/drivers/net/ethernet/pensando/ionic/ionic_txrx.c
index 59eb619d777e..27600efa4cd1 100644
--- a/drivers/net/ethernet/pensando/ionic/ionic_txrx.c
+++ b/drivers/net/ethernet/pensando/ionic/ionic_txrx.c
@@ -613,6 +613,39 @@ static bool ionic_run_xdp(struct ionic_rx_stats *stats,
 	return true;
 }
 
+static void ionic_rx_csum(struct ionic_queue *q, struct sk_buff *skb,
+			  struct ionic_rxq_comp *comp)
+{
+	struct ionic_rx_stats *stats = q_to_rx_stats(q);
+
+	if (unlikely((comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_TCP_BAD) ||
+		     (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_UDP_BAD) ||
+		     (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_IP_BAD)))
+		stats->csum_error++;
+
+	if (unlikely(!(q->lif->netdev->features & NETIF_F_RXCSUM))) {
+		stats->csum_none++;
+		return;
+	}
+
+	/* A header split queue can put the payload where nothing can read
+	 * it, so the stack can't adjust or check a CHECKSUM_COMPLETE sum.
+	 * Take the device's word for the L4 checksum there.
+	 */
+	if ((q->features & IONIC_RXQ_F_HDS) &&
+	    (comp->csum_flags & (IONIC_RXQ_COMP_CSUM_F_TCP_OK |
+				 IONIC_RXQ_COMP_CSUM_F_UDP_OK))) {
+		skb->ip_summed = CHECKSUM_UNNECESSARY;
+		stats->csum_unnecessary++;
+	} else if (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_CALC) {
+		skb->ip_summed = CHECKSUM_COMPLETE;
+		skb->csum = (__force __wsum)le16_to_cpu(comp->csum);
+		stats->csum_complete++;
+	} else {
+		stats->csum_none++;
+	}
+}
+
 static void ionic_rx_clean(struct ionic_queue *q,
 			   struct ionic_rx_desc_info *desc_info,
 			   struct ionic_rxq_comp *comp,
@@ -685,19 +718,7 @@ static void ionic_rx_clean(struct ionic_queue *q,
 		}
 	}
 
-	if (likely(netdev->features & NETIF_F_RXCSUM) &&
-	    (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_CALC)) {
-		skb->ip_summed = CHECKSUM_COMPLETE;
-		skb->csum = (__force __wsum)le16_to_cpu(comp->csum);
-		stats->csum_complete++;
-	} else {
-		stats->csum_none++;
-	}
-
-	if (unlikely((comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_TCP_BAD) ||
-		     (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_UDP_BAD) ||
-		     (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_IP_BAD)))
-		stats->csum_error++;
+	ionic_rx_csum(q, skb, comp);
 
 	if (likely(netdev->features & NETIF_F_HW_VLAN_CTAG_RX) &&
 	    (comp->csum_flags & IONIC_RXQ_COMP_CSUM_F_VLAN)) {

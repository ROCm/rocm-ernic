+	    !test_bit(IONIC_LIF_F_FW_RESET, lif->state)) {
+		cancel_work_sync(&lif->deferred.work);
+		cancel_work_sync(&lif->tx_timeout_work);
+	}
+
+	netdev_lock(lif->netdev);
+	ionic_lif_deinit_locked(lif);
+	netdev_unlock(lif->netdev);

# clang-format configuration for vfu-rdma
# Based on Linux kernel style with some QEMU conventions

BasedOnStyle: LLVM
Language: Cpp

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80
ContinuationIndentWidth: 4

# Braces
BreakBeforeBraces: Linux
BraceWrapping:
  AfterFunction: false
  AfterControlStatement: Never
  AfterStruct: false
  AfterEnum: false

# Spacing
SpaceBeforeParens: ControlStatementsExceptControlMacros
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
PointerAlignment: Right
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Alignment
AlignConsecutiveMacros: Consecutive
AlignConsecutiveDeclarations: false
AlignConsecutiveAssignments: false
AlignTrailingComments: true
AlignEscapedNewlines: Left
AlignOperands: true

# Line breaking
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AlwaysBreakAfterReturnType: None

# Other
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
SortIncludes: false
IncludeBlocks: Preserve
IndentCaseLabels: false

# Warning-suppression macros from shared/rocm-ernic-warnings.h
StatementMacros:
  - ROCM_ERNIC_WARN_CAST_AWAY_CONST_OFF
  - ROCM_ERNIC_WARN_CAST_AWAY_CONST_ON
  - ROCM_ERNIC_WARN_FORMAT_MISMATCH_OFF
  - ROCM_ERNIC_WARN_FORMAT_MISMATCH_ON
  - ROCM_ERNIC_WARN_FORMAT_NONVOID_POINTER_OFF
  - ROCM_ERNIC_WARN_FORMAT_NONVOID_POINTER_ON
  - ROCM_ERNIC_WARN_IMPLICIT_CONVERSION_OFF
  - ROCM_ERNIC_WARN_IMPLICIT_CONVERSION_ON
  - ROCM_ERNIC_WARN_RESERVED_IDENTIFIER_OFF
  - ROCM_ERNIC_WARN_RESERVED_IDENTIFIER_ON
  - ROCM_ERNIC_WARN_SELF_REFERENTIAL_MACRO_OFF
  - ROCM_ERNIC_WARN_SELF_REFERENTIAL_MACRO_ON
  - ROCM_ERNIC_WARN_SIGN_CONVERSION_OFF
  - ROCM_ERNIC_WARN_SIGN_CONVERSION_ON
  - ROCM_ERNIC_WARN_VOID_POINTER_ARITH_OFF
  - ROCM_ERNIC_WARN_VOID_POINTER_ARITH_ON

# Penalties (helps make better formatting decisions)
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakString: 1000
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 200


# Build directories
/build/
/build-*/
*.o
*.a
*.so
*.so.*

# CMake build files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Test artifacts
Testing/

# Editor and IDE files
*~
*.swp
*.swo
.vscode/
.idea/
*.code-workspace
.cursor/
.clangd/
.cache/

# Temporary files
*.tmp
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db

# Core dumps
core
core.*
vgcore.*

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Patch files.  The driver patch series ships in the Ansible collection,
# at ansible/files/patches; see its README for why it lives there.
*.patch
*.diff
# "**/" matches the top level and every subdirectory.  A single-star
# form does not reach a subdirectory, so
# the srq/*.patch under it stayed ignored and the SRQ series was
# invisible to git status -- which looks like "nothing to commit" rather
# than "your patches are not in the tree", and ships a branch whose CI
# cannot find the series it is meant to apply.
!ansible/files/patches/**/*.patch
!ansible/files/patches/**/*.diff
# The RDMA-Tutorial patches that playbooks/tutorial-tests.yml applies.
!ansible/playbooks/files/rdma-tutorial/*.patch

# Log files
*.log

# Tags and ctags.  Anchored: an unanchored "tags" would
# also swallow any directory called tags, at any depth.
/tags
.tags
TAGS
GTAGS
GPATH
GRTAGS

# Coverage
*.gcov
*.gcda
*.gcno

# Ignore nohup.out
nohup.out

# Performance benchmark results
docs/perf-results/

# Ansible collection build output (ansible-galaxy collection
# build), ansible-test scratch, and local -p collection installs
rocm-ernic-*.tar.gz
ansible/tests/output/
ansible/collections/
# ansible-lint and ansible-galaxy stage collections here
ansible/.ansible/
# antsibull-changelog cache (changelog.yaml IS tracked)
ansible/changelogs/.plugin-cache.yaml

# Nix build symlinks and direnv cache (flake.lock IS tracked)
/result
/result-*
/fuzz
.direnv/

# Working notes, not part of the tree
overnight.md

# Local developer convenience, deliberately untracked.  Nothing in CI
# builds these -- the workflows build on the runner directly -- so
# carrying them would only put a Dockerfile in front of the security
# scanners (trivy DS-0002 wants a non-root USER in an image whose whole
# purpose is to run the build as root).
.dockerignore
docker/

# Rendered by ci/report/publish-perf.py from the history on gh-pages.
# The history itself is committed empty; see docs/perf-trends.rst.
docs/perf-history/chart-*.html

# Out-of-tree kernel module build artefacts (drivers/ernic_p4), left by
# "make -C drivers/ernic_p4". The module is built in a guest against its
# own running kernel, so nothing here is ever committed or shipped.
*.ko
*.mod
*.mod.c
*.o
*.o.d
.*.cmd
Module.symvers
modules.order

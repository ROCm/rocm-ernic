# Build directories
/build/
/build-*/
*.o
*.a
*.so
*.so.*

# CMake build files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Test binaries, for an in-source build.  Out-of-source
# builds put these under build/ and line 2 covers them.
tests/test_pci_client

# Other test artifacts
Testing/

# Editor and IDE files
*~
*.swp
*.swo
.vscode/
.idea/
*.code-workspace
.clangd/
.cache/

# Temporary files
*.tmp
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db

# Core dumps
core
core.*
vgcore.*

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Python cache (if any Python scripts added)
__pycache__/
*.py[cod]
*$py.class

# Patch files (exclude patches/ directory which ships driver patches)
*.patch
*.diff
!patches/*.patch
!patches/*.diff

# Log files
*.log

# Tags and ctags.  Anchored: an unanchored "tags" would
# also swallow any directory called tags, at any depth.
/tags
.tags
TAGS
GTAGS
GPATH
GRTAGS

# Static analysis
*.gcov
*.gcda
*.gcno
cov-int/

# Kernel module build artifacts (never tracked)
*.ko
*.mod
*.mod.c
*.mod.o
*.o.cmd
*.ko.cmd
.*.cmd
*.o.d
Module.symvers
modules.order
.cursor/
setup-docs/
setup-scripts/

# Ignore nohup.out
nohup.out

# Performance benchmark results
docs/perf-results/

# VM cloud-init configs (generated by gen-vm)
ansible/playbooks/cloud-config-*
ansible/playbooks/network-config-*

# Ansible collection build output (ansible-galaxy collection
# build), ansible-test scratch, and local -p collection installs
sbates130272-rocm_ernic-*.tar.gz
ansible/tests/output/
ansible/collections/
# ansible-lint and ansible-galaxy stage collections here
ansible/.ansible/
# antsibull-changelog cache (changelog.yaml IS tracked)
ansible/changelogs/.plugin-cache.yaml

# Nix build symlinks and direnv cache (flake.lock IS tracked)
/result
/result-*
/fuzz
.direnv/

# Working notes, not part of the tree
overnight.md

# Rendered by ci/report/publish-perf.py from the history on gh-pages.
# The history itself is committed empty; see docs/perf-trends.rst.
docs/perf-history/chart-*.html
